    def _rebuild_tiling_live(self, monitors):
        self._clear_container(self.tiling_live_box)
        self.tiling_live_cards = {}
        for monitor in monitors:
            name = str(monitor.get("name", "monitor"))
            row = self._tiling_live_row(monitor)
            self.tiling_live_cards[name] = row
            self.tiling_live_box.append(row)
        self._tiling_mark_cards()

    def _sync_tiling_targets(self, names):
        current = getattr(self, "tiling_monitor_names", [])
        self.tiling_monitor_names = names
        if names == current:
            return
        self._tiling_updating = True
        try:
            self.tiling_target_dd.set_model(Gtk.StringList.new(names))
            if names:
                selected = self.tiling_selected_name
                if selected not in names:
                    selected = names[0]
                self.tiling_selected_name = selected
                self.tiling_target_dd.set_selected(names.index(selected))
            self.tiling_target_dd.set_sensitive(bool(names))
        finally:
            self._tiling_updating = False

    def _refresh_tiling(self, force=False):
        if self.win is None:
            return False
        payload = _mmsg_json(["get", "all-monitors"])
        monitors = payload.get("monitors") if isinstance(payload, dict) else None
        if not monitors:
            monitors = []
        active = [m for m in monitors if m.get("active", True)]
        names = [str(m.get("name")) for m in active if m.get("name")]
        self.tiling_monitor_data = {
            str(m.get("name")): m for m in active if m.get("name")}
        self._sync_tiling_targets(names)
        key = json.dumps(active, sort_keys=True, ensure_ascii=False)
        if force or key != getattr(self, "tiling_live_key", None):
            self.tiling_live_key = key
            if active:
                self._rebuild_tiling_live(active)
            else:
                self._clear_container(self.tiling_live_box)
                missing = Gtk.Label(label=(
                    "Mango IPC is unavailable, or no active monitor was "
                    "reported. Refresh after starting a Mango session."))
                missing.add_css_class("dim-label")
                missing.set_xalign(0)
                missing.set_wrap(True)
                self.tiling_live_box.append(missing)
        self._tiling_update_target_info()
        self._tiling_mark_cards()
        return False

    def _tiling_tick(self):
        if self.win is None:
            return False
        self._refresh_tiling()
        return True

    def _tiling_filter(self, *_args):
        text = self.tiling_search.get_text().strip().casefold()
        for name, button in self.tiling_layout_buttons.items():
            symbol, family, desc = LAYOUT_BY_NAME[name]
            haystack = " ".join((name, symbol, family, desc)).casefold()
            button.set_visible(not text or text in haystack)

    def _tiling_apply_layout(self, layout):
        if layout not in LAYOUT_BY_NAME:
            return
        monitor = self._tiling_selected_monitor()
        if not monitor:
            self.tiling_feedback.set_text(
                "No monitor is available. Start Mango and refresh.")
            self.tiling_feedback.add_css_class("error-text")
            return
        focused, focus_msg = _mmsg_dispatch("focusmon", monitor)
        if not focused:
            self.tiling_feedback.set_text(
                "Could not focus %s, so the layout was not changed: %s" %
                (monitor, focus_msg))
            self.tiling_feedback.add_css_class("error-text")
            return
        ok, message = _mmsg_dispatch("setlayout", layout)
        if not ok:
            self.tiling_feedback.set_text(
                "Could not switch %s: %s" % (monitor, message))
            self.tiling_feedback.add_css_class("error-text")
            return
        self.tiling_feedback.remove_css_class("error-text")
        self.tiling_feedback.set_text(
            "Applied %s (%s) to %s." %
            (_layout_label(layout), layout, monitor))
        names = [name for name, _s, _f, _d in LAYOUT_INFO]
        if layout in names:
            self.tiling_default_dd.set_selected(names.index(layout))
        self._refresh_tiling(force=True)

    def _tiling_save_default_clicked(self):
        monitor = self._tiling_selected_monitor()
        if not monitor:
            return
        index = self.tiling_default_dd.get_selected()
        names = [name for name, _s, _f, _d in LAYOUT_INFO]
        if not (0 <= index < len(names)):
            return
        layout = names[index]
        ok, message = _tiling_save_default(monitor, layout)
        self.tiling_feedback.set_text(message)
        if ok:
            self.tiling_feedback.remove_css_class("error-text")
            self.tiling_feedback.set_text(
                message + ". Takes effect after Mango reloads config.conf.")
            self._tiling_refresh_defaults()
        else:
            self.tiling_feedback.add_css_class("error-text")

    def _tiling_remove_default_clicked(self):
        monitor = self._tiling_selected_monitor()
        if not monitor:
            return
        ok, message = _tiling_save_default(monitor, None)
        self.tiling_feedback.set_text(message)
        if ok:
            self.tiling_feedback.remove_css_class("error-text")
            self._tiling_refresh_defaults()
        else:
            self.tiling_feedback.add_css_class("error-text")

