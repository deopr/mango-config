        def pretty_key(k):
            k = (k or "").strip()
            names = {"space": "Space", "comma": "Comma", "minus": "Minus", "equal": "Equal",
                     "slash": "Slash", "period": "Period", "Return": "Return", "Tab": "Tab",
                     "Page_Up": "Page Up", "Page_Down": "Page Down", "Left": "Left",
                     "Right": "Right", "Up": "Up", "Down": "Down", "Print": "Print"}
            if k in names:
                return names[k]
            return k.upper() if len(k) == 1 else k

        def friendly(mod_str, key_str):
            names = {"super": "Super", "mod4": "Super", "ctrl": "Ctrl", "control": "Ctrl",
