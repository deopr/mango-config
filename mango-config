    def _save_default_apps(self, _b=None):
        values = {}
        for role, label, mimes, kind in DEFAULT_APP_ROLES:
            dropdown, ids = self.app_dropdowns.get(kind, (None, []))
            if dropdown is None:
                continue
            selected = dropdown.get_selected()
            if selected <= 0 or selected >= len(ids):
                continue
            desktop_id = ids[selected]
            if not desktop_id:
                continue
            for mime in mimes:
                values[mime] = desktop_id
        if not values:
            self.apps_status.set_text("Choose an application first.")
            return
        self.apps_apply.set_sensitive(False)
        self.apps_status.set_text("Saving…")
        ok, message = _save_default_apps(values)
        self.apps_apply.set_sensitive(True)
        if ok:
            self.apps_status.set_text(
                "Saved · %s" % shortpath(DEFAULT_APPS_FILE))
        else:
            self.apps_status.set_text("Could not save defaults: %s" % message)

