    BIND_RE = re.compile(r"^(bind[a-z]*)=(.*)$")
    SECTION_RE = re.compile(r"^#\s*=+\s*(.+?)\s*=+$")

    # file section -> (top-level category, friendly name)
    KB_SECTIONS = {
        "window management": ("mango", "Window management"),
        "focus navigation": ("mango", "Focus navigation"),
        "window movement": ("mango", "Move windows"),
        "window sizing": ("mango", "Resize windows"),
        "monitor navigation": ("mango", "Monitor navigation"),
        "layout": ("mango", "Layout & gaps"),
        "tags: previous / next": ("mango", "Workspaces: prev / next"),
        "workspace switching": ("mango", "Switch workspace"),
        "move window to workspace": ("mango", "Send window to workspace"),
        "axis / mouse / gesture": ("mango", "Mouse & gestures"),
        "keybinds": ("mango", "General"),
        "application launchers": ("system", "Launchers"),
        "clipboard / power / notifications": ("system", "Clipboard, power & notifications"),
        "screenshot: interactive / full / window": ("system", "Screenshots"),
        "wallpaper": ("system", "Wallpaper"),
        "audio controls": ("system", "Audio"),
        "brightness controls": ("system", "Brightness"),
    }

    def _kb_group_category(self, name, lines):
        key = name.strip().lower()
        mapped = self.KB_SECTIONS.get(key)
        actions = []
        for line in lines:
            body = line.split("=", 1)[1] if "=" in line else ""
            parts = body.split(",")
            if len(parts) >= 3:
                actions.append(parts[2].strip())
        if actions:
            compositor = any(a not in ("spawn", "spawn_shell") for a in actions)
            cat = "mango" if compositor else "system"
            return cat, (mapped[1] if mapped else name.strip() or "Keybinds")
        if mapped:
            return mapped
        return "system", name.strip() or "Keybinds"

    def build_kb_rows_from_lines(self):
        self.kb_rows = []
        self.kb_cards = []
        self.kb_groups = []
        self.kb_expanders = []
        if getattr(self, "kb_groups_box", None) is None:
            return
        self._clear_container(self.kb_groups_box)
        groups, cur = [], None
        for raw in read_lines(BINDS):
            s = raw.strip()
            m = self.SECTION_RE.match(s)
            if m and s.startswith("#"):
                cur = {"name": m.group(1).strip(), "lines": []}
                groups.append(cur)
                continue
            if self.BIND_RE.match(s):
                if cur is None:
                    cur = {"name": "Keybinds", "lines": []}
                    groups.append(cur)
                cur["lines"].append(s)
        cats = [("mango", "Mango  ·  compositor"), ("system", "System  ·  apps & hardware")]
        buckets = {k: [] for k, _ in cats}
        for g in groups:
            if not g["lines"]:
                continue
            cat, pretty = self._kb_group_category(g["name"], g["lines"])
            buckets[cat].append((pretty, g["lines"]))

        self.kb_cats = []
        self._kb_first = set()
        ci = 0
        for cat, cat_title in cats:
            items = buckets[cat]
            if not items:
                continue
            total = sum(len(lines) for _, lines in items)
            cat_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            hdr = Gtk.Label(label=f"{cat_title}   ·   {total}")
            hdr.add_css_class("kb-cat")
