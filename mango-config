def shortpath(path):
    if not path:
        return "not found"
    return path.replace(os.path.expanduser("~"), "~")


def _expand_source(value, config_dir):
    v = value.strip().strip('"').strip("'")
    home = os.path.expanduser("~")
    v = v.replace("${HOME}", home).replace("$HOME", home)
    if v.startswith("~"):
        v = os.path.expanduser(v)
    elif v.startswith("./"):
        v = os.path.join(config_dir, v[2:])
    elif not os.path.isabs(v):
        guess = os.path.join(config_dir, v)
        v = guess if os.path.exists(guess) else v
    return os.path.normpath(v)


def _file_keys(path):
    keys = []
    for line in read_lines(path):
        st = line.strip()
        if not st or st.startswith("#") or st.startswith("["):
            continue
        m = KEY_RE.match(st)
        if m:
            keys.append(m.group(1))
    return keys


class Profile:
    def __init__(self, config_dir):
        self.dir = config_dir
        self.main = os.path.join(config_dir, "config.conf")
        self.toml = os.path.join(config_dir, "config.toml")
        self.files = []
        self.paths = {role: None for role in
                      ("layout", "input", "cursor", "outputs", "rules", "binds",
                       "colors", "theme")}
        self.dms = False
        self.error = ""
        self.warnings = []

    def path(self, role):
        return self.paths.get(role)


def _collect_included_files(profile):
    seen = set()
    ordered = []

    def visit(path):
        real = os.path.realpath(path)
        if real in seen or not os.path.isfile(path):
            return
        seen.add(real)
        ordered.append(path)
        if path.lower().endswith(".toml"):
            return
        for line in read_lines(path):
            st = line.strip()
            if not st or st.startswith("#"):
                continue
            m = re.match(r"^(source_optional|source)\s*=\s*(.+)$", st)
            if not m:
                continue
            raw = m.group(2).strip()
            if "$" in raw and "$HOME" not in raw and "${HOME}" not in raw:
                profile.warnings.append("Skipped source with unresolved variable: " + raw)
                continue
            visit(_expand_source(raw, profile.dir))

    if os.path.isfile(profile.main):
        visit(profile.main)
    profile.files = ordered


def discover_profile(config_dir):
    profile = Profile(config_dir)
    if not os.path.isfile(profile.main):
        if os.path.isfile(profile.toml):
            profile.error = ("Mango is using config.toml, which this version does not "
                             "edit yet. Use config.conf or convert the TOML file.")
        else:
            profile.error = "No config.conf found in " + shortpath(config_dir)
        return profile

    _collect_included_files(profile)
    key_map = {p: _file_keys(p) for p in profile.files}

    for role in ("layout", "input", "cursor", "outputs", "rules", "binds"):
        scored = []
        for idx, path in enumerate(profile.files):
            keys = key_map.get(path, [])
            if role == "binds":
                n = sum(1 for k in keys if k.lower().startswith("bind"))
            else:
                n = sum(1 for k in keys if k in ROLE_KEYS[role])
            if n:
                scored.append((n, idx, path))
        if scored:
            scored.sort(key=lambda t: (t[0], t[1]))
            profile.paths[role] = scored[-1][2]
        else:
            for name in FLAT_NAMES[role]:
                cand = os.path.join(profile.dir, name)
                if cand in profile.files:
                    profile.paths[role] = cand
                    break
            if profile.paths[role] is None:
                for path in profile.files:
                    if os.path.basename(path) in FLAT_NAMES[role]:
                        profile.paths[role] = path

    base_keys = {"border_color", "focus_color", "urgent_color"}
    base_scored = []
    for idx, path in enumerate(profile.files):
        n = sum(1 for k in key_map.get(path, []) if k in base_keys)
        if n:
            base_scored.append((n, idx, path))
    if base_scored:
        base_scored.sort(key=lambda t: (t[0], t[1]))
        profile.paths["colors"] = base_scored[-1][2]
    else:
        for name in FLAT_NAMES["colors"]:
            cand = os.path.join(profile.dir, name)
            if cand in profile.files:
                profile.paths["colors"] = cand
                break

    theme_scored = []
    for idx, path in enumerate(profile.files):
        keys = key_map.get(path, [])
        n = sum(1 for k in keys if k.endswith("_color") and k not in base_keys)
        if n:
            priority = 1 if re.search(r"theme|noctalia|color", os.path.basename(path), re.I) else 0
            theme_scored.append((n, priority, idx, path))
    if theme_scored:
        theme_scored.sort(key=lambda t: (t[0], t[1], t[2]))
        profile.paths["theme"] = theme_scored[-1][3]
    else:
        for name in FLAT_NAMES["theme"]:
            cand = os.path.join(profile.dir, name)
            if cand in profile.files:
                profile.paths["theme"] = cand
                break

    dms_prefix = os.path.join(profile.dir, "dms") + os.sep
    profile.dms = any(p and p.startswith(dms_prefix) for p in profile.paths.values())
    return profile


