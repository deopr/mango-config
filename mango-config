    def filter_kb(self):
        if getattr(self, "kb_search", None) is None:
            return
        q = (self.kb_search.get_text() or "").strip().lower()
        shown = 0
        per_cat = {}
        self._kb_filtering = True
        for exp, inner, ci in getattr(self, "kb_groups", []):
            child = inner.get_first_child()
            matches = 0
            while child is not None:
                nxt = child.get_next_sibling()
                hit = (not q) or (q in getattr(child, "_search_text", ""))
                child.set_visible(hit)
                matches += 1 if hit else 0
                child = nxt
            exp.set_visible(matches > 0)
            if q:
                exp.set_expanded(matches > 0)
            else:
                exp.set_expanded(False)
            per_cat[ci] = per_cat.get(ci, 0) + matches
            shown += matches
        self._kb_filtering = False
        for hdr, cat_box, ci in getattr(self, "kb_cats", []):
            hdr.set_visible(per_cat.get(ci, 0) > 0)
        if q:
            self.kb_count.set_label(f"{shown} match" + ("" if shown == 1 else "es"))
        else:
            self.update_kb_count()

    def _on_kb_expanded(self, exp, _pspec):
        if getattr(self, "_kb_filtering", False) or getattr(self, "_kb_collapsing", False):
            return
        if not exp.get_expanded():
            return
        self._kb_collapsing = True
        for other in getattr(self, "kb_expanders", []):
            if other is not exp and other.get_expanded():
                other.set_expanded(False)
        self._kb_collapsing = False

