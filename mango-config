    def _wallpaper_options_from_controls(self):
        mode_index = self.wall_mode.get_selected()
        mode = WALLPAPER_MODES[mode_index] if 0 <= mode_index < len(WALLPAPER_MODES) else "fill"
        rotate_index = self.wall_rotate.get_selected()
        rotation = rotate_index * 90 if 0 <= rotate_index <= 3 else 0
        return {
            "mode": mode,
            "rotation": rotation,
            "flip_h": bool(self.wall_flip_h.get_active()),
            "flip_v": bool(self.wall_flip_v.get_active()),
        }

    def _wallpaper_options_changed(self, *_args):
        if not hasattr(self, "wall_mode"):
            return
        options = self._wallpaper_options_from_controls()
        _save_wallpaper_options(**options)
        self.wall_options = options
        if getattr(self, "wall_selected", None) and os.path.isfile(self.wall_selected):
            self._show_wallpaper_source(self.wall_selected)

    def _show_wallpaper(self, row):
        if row is None:
            return
        path = getattr(row, "_path", None)
        if path:
            self._show_wallpaper_source(path)

    def _show_wallpaper_source(self, path):
        if not path or not os.path.isfile(path):
            return
        self.wall_selected = path
        options = self._wallpaper_options_from_controls()
        preview_error = ""
        dims = ""
        source_width = source_height = 0
        texture = None
        if GdkPixbuf is not None:
            try:
                if self.wall_pixbuf_path != path or self.wall_pixbuf is None:
                    self.wall_pixbuf = GdkPixbuf.Pixbuf.new_from_file(path)
                    self.wall_pixbuf_path = path
                source_width = self.wall_pixbuf.get_width()
                source_height = self.wall_pixbuf.get_height()
                dims = "%d×%d" % (source_width, source_height)
                screen_w, screen_h = _display_size()
                preview_w, preview_h = _fit_target_size(
                    screen_w, screen_h, 760, 420)
                preview = _compose_wallpaper(
                    self.wall_pixbuf, options["mode"], options["rotation"],
                    options["flip_h"], options["flip_v"],
                    preview_w, preview_h)
                texture = Gdk.Texture.new_for_pixbuf(preview)
            except Exception as ex:
                preview_error = str(ex)
        if texture is None:
            try:
                texture = Gdk.Texture.new_from_filename(path)
            except (GLib.Error, Exception) as ex:
                preview_error = str(ex)
        self.wall_pic.set_paintable(texture)
        try:
            size = os.path.getsize(path)
        except OSError:
            size = 0
        if size >= 1024 * 1024:
            size_text = "%.1f MB" % (size / (1024.0 * 1024.0))
        elif size >= 1024:
            size_text = "%.0f KB" % (size / 1024.0)
        else:
            size_text = "%d bytes" % size
        details = [os.path.basename(path)]
        if dims:
            details.append(dims)
        details.append(size_text)
        details.append(WALLPAPER_MODE_LABELS[options["mode"]].split(" (")[0])
        if options["rotation"]:
            details.append("rotate %d°" % options["rotation"])
        if options["flip_h"]:
            details.append("flip H")
        if options["flip_v"]:
            details.append("flip V")
        self.wall_caption.set_text("  ·  ".join(details))
        self.wall_set_btn.set_sensitive(True)
        if preview_error:
            self.wall_status.set_text("Preview unavailable: %s" % preview_error)

    def _populate_wallpapers(self, select_path=None):
        if not hasattr(self, "wall_list"):
            return
        previous = select_path or self.wall_selected
        current = _current_wallpaper_source()
        files = _wallpaper_files(self.wall_dir)
        self._clear_container(self.wall_list)
        self.wall_rows = []
        self.wall_pixbuf = None
        self.wall_pixbuf_path = ""
        target_row = None
        for path in files:
            row = Gtk.ListBoxRow()
            row._path = path
            row._name = os.path.basename(path)
            row.set_tooltip_text(path)
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            name = Gtk.Label(label=row._name)
            name.set_xalign(0)
            name.set_hexpand(True)
            name.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
            box.append(name)
            if current and os.path.realpath(path) == os.path.realpath(current):
                badge = Gtk.Label(label="current")
                badge.add_css_class("dim-label")
                box.append(badge)
            row.set_child(box)
            self.wall_list.append(row)
            self.wall_rows.append(row)
            if previous and os.path.realpath(path) == os.path.realpath(previous):
                target_row = row
        if target_row is None:
            for row in self.wall_rows:
                if current and os.path.realpath(row._path) == os.path.realpath(current):
                    target_row = row
                    break
        if target_row is None and self.wall_rows:
            target_row = self.wall_rows[0]
        self.wall_count.set_text("%d wallpaper%s" % (
            len(files), "" if len(files) == 1 else "s"))
        self._filter_wallpapers()
        if target_row is not None:
            self.wall_list.select_row(target_row)
            self._show_wallpaper(target_row)
        else:
            self.wall_selected = None
            self.wall_pic.set_paintable(None)
            self.wall_caption.set_text(
                "No images found in %s" % shortpath(self.wall_dir))
            self.wall_set_btn.set_sensitive(False)

    def _filter_wallpapers(self, _entry=None):
        if not hasattr(self, "wall_search") or not hasattr(self, "wall_rows"):
            return
        query = self.wall_search.get_text().strip().casefold()
        shown = 0
        for row in self.wall_rows:
            visible = not query or query in row._name.casefold()
            row.set_visible(visible)
            if visible:
                shown += 1
        total = len(self.wall_rows)
        if query:
            self.wall_count.set_text("%d of %d" % (shown, total))
        else:
            self.wall_count.set_text("%d wallpaper%s" % (
                total, "" if total == 1 else "s"))

    def _apply_wallpaper(self, path=None):
        path = path or self.wall_selected
        if not path or not os.path.isfile(path):
            self.wall_status.set_text("Select a wallpaper first.")
            return
        options = self._wallpaper_options_from_controls()
        _save_wallpaper_options(**options)
        self.wall_options = options
        self.wall_set_btn.set_sensitive(False)
        self.wall_status.set_text("Preparing wallpaper…")

        def worker():
            rendered = path
            try:
                if GdkPixbuf is not None:
                    canvas = _render_wallpaper(path, options)
                    rendered = _save_wallpaper_pixbuf(canvas)
            except Exception as ex:
                GLib.idle_add(self._wallpaper_render_failed, str(ex))
                return
            GLib.idle_add(self._wallpaper_rendered, path, rendered)

        threading.Thread(target=worker, daemon=True).start()

    def _wallpaper_render_failed(self, error):
        self.wall_set_btn.set_sensitive(True)
        self.wall_status.set_text("Wallpaper failed: %s" % error)
        return False

    def _wallpaper_rendered(self, source, rendered):
        script = _light_wallpaper()
        if script:
            self.wall_status.set_text("Applying wallpaper…")

            def worker():
                try:
                    proc = subprocess.run(
                        [script, rendered], capture_output=True, text=True,
                        timeout=60)
                    code = proc.returncode
                    err = (proc.stderr or "").strip()
                except (OSError, subprocess.SubprocessError) as ex:
                    code, err = 1, str(ex)
                GLib.idle_add(self._wallpaper_done, source, rendered, code, err)

            threading.Thread(target=worker, daemon=True).start()
            return False
        self._apply_wallpaper_fallback(rendered, source)
        return False

    def _apply_wallpaper_fallback(self, path, source=None):
        link_error = ""
        try:
            parent = os.path.dirname(WALLPAPER_LINK)
            if parent:
                os.makedirs(parent, exist_ok=True)
            tmp = WALLPAPER_LINK + ".tmp"
            if os.path.lexists(tmp):
                os.unlink(tmp)
            os.symlink(path, tmp)
            os.replace(tmp, WALLPAPER_LINK)
        except OSError as ex:
            link_error = str(ex)
        swaybg = shutil.which("swaybg")
        if not swaybg:
            self._wallpaper_done(source or path, path, 1,
                                 link_error or "swaybg is not installed")
            return
        service_active = False
        try:
            service_active = subprocess.run(
                ["systemctl", "--user", "is-active", "--quiet", "swaybg.service"],
                timeout=3).returncode == 0
        except (OSError, subprocess.SubprocessError):
            pass
        if service_active and os.path.islink(WALLPAPER_LINK):
            try:
                subprocess.run(
                    ["systemctl", "--user", "restart", "swaybg.service"],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                    timeout=8)
                self._wallpaper_done(source or path, path, 0, "")
            except (OSError, subprocess.SubprocessError) as ex:
                self._wallpaper_done(source or path, path, 1, str(ex))
            return
        try:
            subprocess.run(
                ["pkill", "-x", "swaybg"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
        except (OSError, subprocess.SubprocessError):
            pass
        try:
            subprocess.Popen(
                [swaybg, "-m", "fill", "-i", path],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True)
        except OSError as ex:
            self._wallpaper_done(source or path, path, 1,
                                 "could not start swaybg: %s" % ex)
            return
        self._wallpaper_done(source or path, path, 0, "")

    def _wallpaper_done(self, source, rendered, code, error):
        self.wall_set_btn.set_sensitive(True)
        if code == 0:
            _write_text(WALLPAPER_STATE, source)
            options = self._wallpaper_options_from_controls()
            _save_wallpaper_options(source=source, rendered=rendered, **options)
            self.wall_options = options
            self.wall_status.set_text(
                "Wallpaper applied · %s" % os.path.basename(source))
            self._populate_wallpapers(select_path=source)
        else:
            detail = error.splitlines()[-1] if error else "exit code %s" % code
            self.wall_status.set_text("Wallpaper failed: %s" % detail)
        return False

    def _quick_pick_wallpaper(self, _b=None):
        fuzzel = shutil.which("fuzzel")
        script = _light_wallpaper()
        if not fuzzel and not script:
            self.wall_status.set_text("fuzzel is not installed.")
            return
        self.wall_status.set_text("Fuzzel picker open…")
        self.wall_set_btn.set_sensitive(False)
        before = _current_wallpaper_source()

        def worker():
            try:
                if fuzzel:
                    names = [os.path.basename(p) for p in _wallpaper_files(self.wall_dir)]
                    if not names:
                        GLib.idle_add(self._quick_pick_done, 1, "", before)
                        return
                    proc = subprocess.run(
                        [fuzzel, "--dmenu", "--prompt=Wallpaper "],
                        input="\n".join(names), capture_output=True, text=True,
                        timeout=300)
                    choice = (proc.stdout or "").strip()
                    GLib.idle_add(self._quick_pick_done, 0 if choice else 1,
                                  choice, before)
                    return
                # A helper with its own picker still gets the app's fit options:
                # re-apply its selected source through the normal render path.
                proc = subprocess.run([script], timeout=300)
                after = _current_wallpaper_source()
                GLib.idle_add(self._quick_pick_helper_done, proc.returncode,
                              after, before)
            except (OSError, subprocess.SubprocessError):
                GLib.idle_add(self._quick_pick_done, 1, "", before)

        threading.Thread(target=worker, daemon=True).start()

    def _quick_pick_helper_done(self, code, after, before):
        if code == 0 and after and after != before and os.path.isfile(after):
            self.wall_selected = after
            self._apply_wallpaper(after)
            return False
        self.wall_set_btn.set_sensitive(True)
        self.wall_status.set_text(
            "No wallpaper change." if code == 0 else "Fuzzel picker closed.")
        return False

    def _quick_pick_done(self, code, choice, before=None):
        if choice:
            self._apply_wallpaper(os.path.join(self.wall_dir, choice))
            return False
        self.wall_set_btn.set_sensitive(True)
        if code == 0:
            current = _current_wallpaper_source()
            self._populate_wallpapers(select_path=current)
            if current and current != before:
                self.wall_status.set_text("Wallpaper updated from fuzzel pick.")
            else:
                self.wall_status.set_text("No wallpaper change.")
        else:
            self.wall_status.set_text("Fuzzel picker closed.")
        return False

