        t.set_xalign(0)
        d = Gtk.Label(label=subtitle)
        d.add_css_class("dim-label")
        d.set_xalign(0)
        d.set_wrap(True)
        p = Gtk.Label(label=shortpath(path))
        p.add_css_class("page-path")
        p.set_xalign(0)
        header.append(t)
        header.append(d)
        header.append(p)
        if not isinstance(child, Gtk.ScrolledWindow):
            sc = Gtk.ScrolledWindow()
            sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            sc.set_child(child)
            child = sc
        child.set_hexpand(True)
        child.set_vexpand(True)
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        page.append(header)
        page.append(child)
        return page

