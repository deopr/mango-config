    def _wr_line(self, entry):
        kv = dict(entry.get("extra") or {})
        present = entry.get("present") or set()
        app = entry["app"].get_text().strip()
        title = entry["title"].get_text().strip()
        if app:
            kv["app_id"] = app
        else:
            kv.pop("app_id", None)
        if title:
            kv["title"] = title
        else:
            kv.pop("title", None)
        for key, check in entry["toggles"].items():
            if check.get_active() or key in present:
                kv[key] = "1" if check.get_active() else "0"
            else:
                kv.pop(key, None)
        for key, widget in entry["text"].items():
            value = widget.get_text().strip()
            if value:
                kv[key] = value
            else:
                kv.pop(key, None)
        if not kv:
            return None
        keys = [key for key in WR_ORDER if key in kv]
        keys += [key for key in kv if key not in WR_ORDER]
        return ",".join("%s:%s" % (key, kv[key]) for key in keys)

