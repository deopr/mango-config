    def _bar_action(self, engine, action):
        if action == "start":
            ok, message = _bar_start(engine)
        elif action == "stop":
            ok, message = _bar_stop(engine)
        else:
            ok, message = _bar_restart(engine)
        self._bar_feedback(engine, message, error=not ok)
        self._refresh_bar_status()

    def _refresh_bar_status(self):
        if self.win is None:
            return False
        for engine in ("mangobar", "waybar"):
            state = _bar_status(engine)
            label = self.bar_status_labels.get(engine)
            meta = self.bar_meta_labels.get(engine)
            paths = self.bar_path_labels.get(engine)
            buttons = self.bar_action_buttons.get(engine)
            if label is None:
                continue
            installed = bool(shutil.which("mangobar" if engine == "mangobar"
                                          else "waybar"))
            if state["running"]:
                if state["service_active"]:
                    text = "Running · " + state["unit"]
                else:
                    text = "Running · PID " + ", ".join(
                        str(p) for p in state["pids"])
                label.set_text(text)
                label.remove_css_class("off")
                label.add_css_class("on")
            else:
                if state["service_exists"]:
                    text = "Stopped · service available"
                elif installed:
                    text = "Stopped · executable available"
                else:
                    text = "Stopped · not installed"
                label.set_text(text)
                label.remove_css_class("on")
                label.add_css_class("off")

            bits = []
            if state["height"] is not None:
                bits.append("%s px" % state["height"])
            if state["layer"]:
                bits.append("layer %s" % state["layer"])
            if state["position"]:
                bits.append("position %s" % state["position"])
            if not state["config_exists"]:
                bits.append("config will be created on first save")
            detail = " · ".join(bits)
            meta.set_text(("Mango tags, layout and status modules. " + detail)
                          if engine == "mangobar" else
                          ("Waybar with ext/workspaces and a mmsg-backed layout "
                           "module. " + detail))

            config = shortpath(state["config"])
            style = shortpath(state["style"])
            paths.set_text("config: %s\nstyle:  %s" % (config, style))
            paths.set_tooltip_text("config: %s\nstyle: %s" % (
                state["config"], state["style"]))

            if buttons:
                buttons["start"].set_sensitive(
                    not state["running"] and
                    (state["service_exists"] or installed))
                buttons["stop"].set_sensitive(state["running"])
                buttons["restart"].set_sensitive(state["running"])
        return False

    def _bar_status_tick(self):
        if self.win is None:
            return False
        self._refresh_bar_status()
        return True

    def _confirm_action(self, title, detail, on_confirm):
        dialog = Gtk.AlertDialog()
        dialog.set_message(title)
        dialog.set_detail(detail)
        dialog.set_buttons(["Cancel", "Continue"])
        dialog.set_cancel_button(0)
        dialog.set_default_button(1)

        def finished(source, result):
            try:
                choice = source.choose_finish(result)
            except GLib.Error:
                return
            if choice == 1:
                on_confirm()

        dialog.choose(self.win, None, finished)

