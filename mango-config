    # ---- load / apply / reset

    def load_all(self):
        for c in self.controls:
            w = c["widget"]
            kind, path, key = c["kind"], c["path"], c["key"]
            lines = read_lines(path)
            cur = get_simple(lines, key)
            if cur is None:
                continue
            if kind == "int":
                w.set_value(int(float(cur)))
            elif kind == "float":
                w.set_value(float(cur))
            elif kind == "switch":
                w.set_state(cur == "1")
            elif kind == "dropdown":
                themes = self._dropdown_themes.get(w, [])
                if themes and w in self._dropdown_themes:
                    idx = 0
                    if cur and cur in themes:
                        idx = themes.index(cur)
                    w.set_selected(idx)
            elif kind == "color":
                try:
                    w.set_rgba(hex_to_rgba(cur))
                except Exception:
                    pass
            elif kind == "str":
                w.set_text(cur)
        # outputs / window rules / keybinds: rebuild from disk
        self.load_output_rules()
        self.load_wr_from_lines()
        self.build_kb_rows_from_lines()

    def load_wr_from_lines(self):
        self.wr_rows = []
        self.wr_deleted = set()
        if not WINDOWRULES or getattr(self, "wr_box", None) is None:
            return
        self._clear_container(self.wr_box)
        lines = read_lines(WINDOWRULES)
        for line in lines:
            if line.strip().startswith("window_rule="):
                e = self.add_wr_rule(line=line.strip())
        if not self.wr_rows:
            self.add_wr_rule()

    def _clear_container(self, box):
        child = box.get_first_child()
        while child is not None:
            nxt = child.get_next_sibling()
            box.remove(child)
            child = nxt

    def b_reset(self, _b):
        self.load_all()
        self.status.set_label("Reloaded from disk.")
        self.status.remove_css_class("destructive-action")

    def _profile_paths(self):
        if PROFILE is not None:
            vals = [PROFILE.main] + list(PROFILE.paths.values())
        else:
            vals = [LAYOUT, NOCTALIA, COLORS, INPUT, CURSOR, OUTPUTS, WINDOWRULES, BINDS]
        out = []
        for path in vals:
            if path and path not in out:
                out.append(path)
        return out

    def on_apply(self, _b):
        paths = self._profile_paths()
        snapshot = {p: read_lines(p) for p in paths if os.path.exists(p)}
        bakdir = os.path.join(CONFIG_DIR, ".autobak")
        try:
            os.makedirs(bakdir, exist_ok=True)
            stamp = time.strftime("%Y%m%d-%H%M%S")
            for p in paths:
                if os.path.exists(p):
                    rel = os.path.relpath(p, CONFIG_DIR).replace(os.sep, "_")
                    shutil.copy2(p, os.path.join(bakdir, stamp + "-" + rel))
        except OSError:
            pass
        touched = {}
        for c in self.controls:
            w = c["widget"]
            kind, path, key = c["kind"], c["path"], c["key"]
            if not path or not os.path.isfile(path):
                continue
            if path not in touched:
                touched[path] = read_lines(path)
            lines = touched[path]
            cur = get_simple(lines, key)
            # Never invent settings that were not already in this file.
            if cur is None:
                continue
            if kind == "int":
                try:
                    if int(float(cur)) == int(w.get_value()):
                        continue
                except (TypeError, ValueError):
                    pass
                new = str(int(w.get_value()))
            elif kind == "float":
                try:
                    if abs(float(cur) - w.get_value()) < 1e-9:
                        continue
                except (TypeError, ValueError):
                    pass
                new = fmt_float(w.get_value())
            elif kind == "switch":
                if (cur == "1") == bool(w.get_state()):
                    continue
                new = "1" if w.get_state() else "0"
            elif kind == "dropdown":
                themes = self._dropdown_themes.get(w, [])
                sel = w.get_selected()
                new = themes[sel] if isinstance(sel, int) and 0 <= sel < len(themes) else cur
            elif kind == "color":
                try:
                    old_rgba = hex_to_rgba(cur)
                    new_rgba = w.get_rgba()
                    if all(abs(getattr(old_rgba, c) - getattr(new_rgba, c)) < (0.5 / 255.0)
                           for c in ("red", "green", "blue", "alpha")):
                        continue
                except Exception:
                    pass
                new = rgba_to_hex(w.get_rgba())
            elif kind == "str":
                new = w.get_text()
            else:
                continue
            if new == cur:
                continue
            touched[path] = set_simple(lines, key, new, sep=key_sep(lines, key))
        for path, lines in touched.items():
            if lines != snapshot.get(path):
                write_lines(path, lines)

        outputs_changed = False
        old_outputs = None
        if OUTPUTS and hasattr(self, "out_rows") and getattr(self, "out_box", None) is not None:
            old_outputs = read_lines(OUTPUTS)
            pool = {}
            for e in self.out_rows:
                if e.get("orig"):
                    pool.setdefault(e["orig"], []).append(e)
            out_lines = []
            for raw in read_lines(OUTPUTS):
                s = raw.strip()
                if s.startswith("monitor_rule="):
                    q = pool.get(s)
                    if not q:
                        continue
                    e = q.pop(0)
                    line = self._monitor_line(e)
                    if line:
                        newline = "monitor_rule=" + line
                        e["orig"] = newline
                        out_lines.append(newline + "\n")
                else:
                    out_lines.append(raw)
            for e in self.out_rows:
                if not e.get("orig"):
                    line = self._monitor_line(e)
                    if line:
                        newline = "monitor_rule=" + line
                        e["orig"] = newline
                        out_lines.append(newline + "\n")
            outputs_changed = old_outputs != out_lines
            if outputs_changed:
                write_lines(OUTPUTS, out_lines)

        if WINDOWRULES and hasattr(self, "wr_rows"):
            orig_rules = read_lines(WINDOWRULES)
            deleted = getattr(self, "wr_deleted", set())
            out_lines = []
            pool = {}
            for e in self.wr_rows:
                if e.get("orig"):
                    pool.setdefault(e["orig"], []).append(e)
            for raw in orig_rules:
                s = raw.strip()
                if s.startswith("window_rule="):
                    if s in deleted:
                        continue
                    q = pool.get(s)
                    if not q:
                        # Untracked lines stay exactly as they were; only a
                        # rule explicitly deleted through the UI is removed.
                        out_lines.append(raw)
                        continue
                    e = q.pop(0)
                    line = self._wr_line(e)
                    if line:
                        newline = "window_rule=" + line
                        e["orig"] = newline
                        out_lines.append(newline + "\n")
                else:
                    out_lines.append(raw)
            for e in self.wr_rows:
                if e.get("orig"):
                    continue
                line = self._wr_line(e)
                if line:
                    newline = "window_rule=" + line
                    e["orig"] = newline
                    out_lines.append(newline + "\n")
            if out_lines != orig_rules:
                write_lines(WINDOWRULES, out_lines)
                self.wr_deleted = set()

        if BINDS and hasattr(self, "kb_rows"):
            orig_lines = read_lines(BINDS)
            pool = {}
            for e in self.kb_rows:
                if e.get("orig"):
                    pool.setdefault(e["orig"], []).append(e)
            # Add new shortcuts next to their existing action, not at the end
            # of the file where they could change section on the next reload.
            insert_after = {}
            for group in getattr(self, "kb_cards", []):
                new_combos = [c for c in group["combos"] if not c.get("orig")]
                if not new_combos:
                    continue
                orig_combos = [c for c in group["combos"] if c.get("orig")]
                if orig_combos:
                    insert_after.setdefault(orig_combos[-1]["orig"], []).extend(new_combos)
            out_lines = []
            for raw in orig_lines:
                s = raw.strip()
                if self.BIND_RE.match(s):
                    q = pool.get(s)
                    if not q:
                        continue  # row was deleted on purpose
                    e = q.pop(0)
                    newline = self._kb_line(e)
                    if newline:
                        e["orig"] = newline
                        out_lines.append(newline + "\n")
                    for combo in insert_after.get(s, []):
                        extra = self._kb_line(combo)
                        if extra:
                            combo["orig"] = extra
                            out_lines.append(extra + "\n")
                else:
                    out_lines.append(raw)
            for e in self.kb_rows:
                if not e.get("orig"):
                    newline = self._kb_line(e)
                    if newline:
                        e["orig"] = newline
                        out_lines.append(newline + "\n")
            if out_lines and not out_lines[-1].endswith("\n"):
                out_lines[-1] += "\n"
            if out_lines != orig_lines:
                write_lines(BINDS, out_lines)

        ok, msg = self._validate_config()
        if not ok:
            for path, snap in snapshot.items():
                write_lines(path, snap)
            self.load_all()
            self.status.set_label("Invalid — reverted: " + msg)
            self.status.add_css_class("destructive-action")
            return
        if self.no_reload:
            self.status.set_label("Applied — reload skipped.")
        else:
            reloaded = self._reload_mango()
            self.status.set_label("Applied — Mango reloaded." if reloaded
                                  else "Applied. Reload Mango to see the changes.")
        self.status.remove_css_class("destructive-action")
        if outputs_changed and old_outputs is not None:
            self._show_output_guard(old_outputs)

    def _show_output_guard(self, old_lines):
        if self._guard_src is not None:
            GLib.source_remove(self._guard_src)
            self._guard_src = None
            old_lines = self._guard_old or old_lines
        self._guard_old = old_lines
        self._guard_left = 10
        self.guard_label.set_text("Reverting to the previous settings in 10s…")
        self.guard_revealer.set_reveal_child(True)
        self.apply_btn.set_sensitive(False)
        self._guard_src = GLib.timeout_add(1000, self._guard_tick)

    def _guard_tick(self):
        self._guard_left -= 1
        if self._guard_left <= 0:
            self._guard_src = None
            self._guard_finish(True)
            return False
        self.guard_label.set_text("Reverting to the previous settings in %ds…" % self._guard_left)
        return True

    def _guard_finish(self, do_revert):
        if self._guard_src is not None:
            GLib.source_remove(self._guard_src)
            self._guard_src = None
        if do_revert and self._guard_old is not None and OUTPUTS:
            write_lines(OUTPUTS, self._guard_old)
            self._reload_mango()
            self.load_output_rules()
            self.status.set_label("Display settings reverted — nothing changed.")
            self.status.add_css_class("destructive-action")
        else:
            self.status.set_label("Display settings kept.")
            self.status.remove_css_class("destructive-action")
        self._guard_old = None
        self.guard_revealer.set_reveal_child(False)
        self.apply_btn.set_sensitive(True)

    def _on_close_request(self, *_a):
        if getattr(self, "_guard_old", None) is not None:
            self._guard_finish(True)
        return False

    def _kb_line(self, e):
        group = e.get("group")
        if group is None:
            return None
        combo = e["e_combo"].get_text().strip()
        while self.BIND_RE.match(combo):
            combo = self.BIND_RE.match(combo).group(2).strip()
        mods, key = self._kb_combo_parts(combo)
        action = group["e_act"].get_text().strip()
        args = group["e_args"].get_text().strip()
        while self.BIND_RE.match(action):
            action = self.BIND_RE.match(action).group(2).strip()
        while self.BIND_RE.match(args):
            args = self.BIND_RE.match(args).group(2).strip()
        if not key or not action:
            return None
        parts = [mods, key, action, args]
        while parts and parts[-1] == "":
            parts.pop()
        flag = group.get("flag") or e.get("flag") or "bind"
        line = flag + "=" + ",".join(parts)
        return line if len(line.encode("utf-8")) <= 255 else None

    def _validate_config(self):
        try:
            res = subprocess.run(["mango", "-p", "-c", os.path.join(CONFIG_DIR, "config.conf")],
                                 capture_output=True, text=True, timeout=10)
        except Exception as ex:
            return True, "validator failed: %s" % ex
        out = re.sub(r"\x1b\[[0-9;]*m", "", (res.stdout or "") + (res.stderr or "")).strip()
        bad = res.returncode != 0 or re.search(r"\berror\b|unknown|exceeds|invalid", out, re.I)
        return (not bad), out[:220]

    def _reload_mango(self):
        import glob as _glob
        import socket as _socket
        for sp in _glob.glob("/run/user/%d/mango-*.sock" % os.getuid()):
            try:
                s = _socket.socket(_socket.AF_UNIX, _socket.SOCK_STREAM)
                s.settimeout(2)
                s.connect(sp)
                s.sendall(b"dispatch reload_config\n")
                s.recv(4096)
                s.close()
                return True
            except OSError:
                continue
        return False


def parse_args(argv):
    ap = argparse.ArgumentParser(
        prog="mango-config",
        description="GTK4 settings app for the Mango Wayland compositor.")
    ap.add_argument("--config-dir", metavar="DIR",
                    help="Mango config directory (default: ~/.config/mango)")
    ap.add_argument("--tab", metavar="ID",
                    help="open a tab directly (layout, theme, colors, cursor, mouse, "
                         "touchpad, keys, wallpaper, outputs, night, rules)")
    ap.add_argument("--no-reload", action="store_true",
                    help="write and validate, but do not reload Mango")
    ap.add_argument("--version", action="version",
                    version="mango-config " + VERSION)
    return ap.parse_args(argv)


def main():
    args = parse_args(sys.argv[1:])
    config_dir = os.path.abspath(os.path.expanduser(
        args.config_dir or os.environ.get("MANGO_CONFIG_DIR") or "~/.config/mango"))
    profile = discover_profile(config_dir)
    configure_profile(profile)
    app = App(profile=profile, tab=args.tab, no_reload=args.no_reload)
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    main()
