    def _xkb_layout_options(self):
        """Return (code, label) pairs from the system XKB rules database."""
        rows = []
        seen = set()
        base = "/usr/share/X11/xkb/rules/base.lst"
        try:
            in_layout = False
            with open(base, encoding="utf-8", errors="replace") as fh:
                for raw in fh:
                    if raw.startswith("! layout"):
                        in_layout = True
                        continue
                    if raw.startswith("!"):
                        in_layout = False
                        continue
                    if not in_layout:
                        continue
                    parts = raw.strip().split(None, 1)
                    if not parts or parts[0].startswith("!"):
                        continue
                    code = parts[0].strip()
                    name = parts[1].strip() if len(parts) > 1 else code
                    if code and code not in seen:
                        seen.add(code)
                        rows.append((code, name))
        except OSError:
            pass
        if not rows:
            rows = list(COMMON_XKB_LAYOUTS)
        return rows

    def _live_keyboard_layout(self):
        """Ask Mango which layout is currently active, if IPC is available."""
        if not shutil.which("mmsg"):
            return ""
        try:
            out = subprocess.run(
                ["mmsg", "get", "keyboardlayout"],
                capture_output=True, text=True, timeout=2)
            if out.returncode != 0:
                return ""
            data = json.loads(out.stdout)
            return str(data.get("layout") or "")
        except (OSError, subprocess.SubprocessError, ValueError):
            return ""

