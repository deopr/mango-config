def kb_token(value):
    """Normalize a modifier or key name from a bind or the visual keyboard."""
    token = (value or "").strip().lower().replace("-", "_")
    token = KB_TOKEN_ALIASES.get(token, token)
    return token


def kb_bind_tokens(mods, key):
    """Return the set of keyboard-map tokens used by one bind."""
    tokens = set()
    for part in (mods or "").split("+"):
        token = kb_token(part)
        if token:
            tokens.add(token)
    token = kb_token(key)
    if token:
        tokens.add(token)
    return tokens


class XkbLayoutPicker(Gtk.MenuButton):
    """A layout picker with a live, always-filtering search field."""

    def __init__(self, options, current):
        super().__init__()
        self.options = list(options)
        self.labels = {code: label for code, label in self.options}
        self._code = current
        self.add_css_class("xkb-picker")
        self.set_tooltip_text("Choose a keyboard layout")

        self._label = Gtk.Label(label=self.labels.get(current, current))
        self._label.set_xalign(0)
        self._label.set_hexpand(True)
        self._label.set_ellipsize(Pango.EllipsizeMode.END)
        self._label.set_max_width_chars(30)
        child = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        child.append(self._label)
        child.append(Gtk.Image.new_from_icon_name("pan-down-symbolic"))
        self.set_child(child)

        pop = Gtk.Popover()
        self.set_popover(pop)
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        outer.set_margin_top(8)
        outer.set_margin_bottom(8)
        outer.set_margin_start(8)
        outer.set_margin_end(8)

        self._search = Gtk.SearchEntry()
        self._search.set_placeholder_text("Search layouts…")
        self._search.set_hexpand(True)
        # notify::text is immediate; GtkSearchEntry's search-changed signal
        # deliberately waits for search-delay, which made the old dropdown feel
        # like it ignored a query that was already on screen.
        self._search.connect("notify::text", lambda _e, _p: self._rebuild_rows())
        outer.append(self._search)

        self._list = Gtk.ListBox()
        self._list.add_css_class("xkb-layout-list")
        self._list.set_selection_mode(Gtk.SelectionMode.NONE)
        self._list.connect("row-activated", self._on_row_activated)
        self._scroll = Gtk.ScrolledWindow()
        self._scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self._scroll.set_min_content_width(360)
        self._scroll.set_min_content_height(320)
        self._scroll.set_child(self._list)
        outer.append(self._scroll)
        pop.set_child(outer)

        self.connect("notify::active", self._on_popover_active)
        self._rebuild_rows()

    def get_code(self):
        return self._code

    def set_code(self, code):
        if code == self._code:
            return
        self._code = code
        self._label.set_text(self.labels.get(code, code))

    def _on_popover_active(self, *_args):
        if not self.get_active():
            return
        self._search.set_text("")
        self._rebuild_rows()
        GLib.idle_add(self._focus_search)

    def _focus_search(self):
        self._search.grab_focus()
        return False

    def _clear_rows(self):
        child = self._list.get_first_child()
        while child is not None:
            nxt = child.get_next_sibling()
            self._list.remove(child)
            child = nxt

    def _rebuild_rows(self):
        query = (self._search.get_text() or "").strip().casefold()
        self._clear_rows()
        matches = [
            (code, label) for code, label in self.options
            if not query or query in label.casefold() or query in code.casefold()
        ]
        if query:
            matches.sort(key=lambda item: (
                0 if item[0] == self._code else 1,
                0 if item[0].casefold() == query or item[1].casefold().startswith(query) else 1,
                item[1].casefold()))
        else:
            matches.sort(key=lambda item: (
                0 if item[0] == self._code else 1, item[1].casefold()))
        for code, label in matches:
            row = Gtk.ListBoxRow()
            row.set_activatable(True)
            row._layout_code = code
            row._layout_label = label
            if code == self._code:
                row.add_css_class("xkb-layout-selected")
            lbl = Gtk.Label(label=label)
            lbl.set_xalign(0)
            lbl.set_ellipsize(Pango.EllipsizeMode.END)
            row.set_child(lbl)
            self._list.append(row)
        if not matches:
            row = Gtk.ListBoxRow()
            row.set_activatable(False)
            lbl = Gtk.Label(label="No matching layouts")
            lbl.add_css_class("dim-label")
            lbl.set_xalign(0)
            row.set_child(lbl)
            self._list.append(row)

    def _on_row_activated(self, _listbox, row):
        code = getattr(row, "_layout_code", None)
        if not code:
            return
        label = getattr(row, "_layout_label", code)
        self._code = code
        self._label.set_text(label)
        self.set_active(False)


def shortpath(path):
    if not path:
        return "not found"
    return path.replace(os.path.expanduser("~"), "~")


def _read_json(path):
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def _write_json(path, data):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(data, fh, indent=2)
            fh.write("\n")
        os.replace(tmp, path)
    except OSError:
        pass


def _read_text(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read().strip()
    except OSError:
        return ""


def _write_text(path, value):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write(value + "\n")
        os.replace(tmp, path)
    except OSError:
        pass


# ---- JSONC / bar helpers ---------------------------------------------------

def _jsonc_strip(text):
    """Remove // and /* */ comments plus trailing commas outside strings."""
    out = []
    i, n = 0, len(text)
    in_str = False
    while i < n:
        c = text[i]
        if in_str:
            out.append(c)
            if c == "\\" and i + 1 < n:
                out.append(text[i + 1])
                i += 2
                continue
            if c == '"':
                in_str = False
            i += 1
            continue
        if c == '"':
            in_str = True
            out.append(c)
            i += 1
            continue
        if c == "/" and i + 1 < n and text[i + 1] == "/":
            while i < n and text[i] != "\n":
                i += 1
            if i < n:
                out.append("\n")
                i += 1
            continue
        if c == "/" and i + 1 < n and text[i + 1] == "*":
            i += 2
            while i + 1 < n and not (text[i] == "*" and text[i + 1] == "/"):
                i += 1
            i += 2
            continue
        if c in "}]":
            j = len(out)
            while j > 0 and out[j - 1] in " \t\r\n":
                j -= 1
            if j > 0 and out[j - 1] == ",":
                del out[j - 1]
        out.append(c)
        i += 1
    return "".join(out)


def _parse_jsonc(text, default=None):
    """Parse JSON-with-comments; return default on any syntax error."""
    try:
        data = json.loads(_jsonc_strip(text))
    except (TypeError, ValueError):
        return default
    return data


def _read_jsonc(path, default=None):
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        return default
    return _parse_jsonc(text, default)


def _bar_config_dir(engine):
    config_home = os.path.abspath(os.path.expanduser(
        os.environ.get("XDG_CONFIG_HOME") or "~/.config"))
    if engine == "mangobar":
        env = os.environ.get("MANGOBAR_CONFIG")
        if env:
            return os.path.dirname(os.path.abspath(os.path.expanduser(env)))
        return os.path.join(config_home, "mangobar")
    return os.path.join(config_home, "waybar")


def _bar_config_paths(engine):
    """Return (config_path, style_path) preferring an existing extension."""
    directory = _bar_config_dir(engine)
    if engine == "mangobar":
        env = os.environ.get("MANGOBAR_CONFIG")
        if env:
            config = os.path.abspath(os.path.expanduser(env))
            return config, os.path.join(directory, "style.css")
    config = None
    for name in ("config.jsonc", "config.json"):
        candidate = os.path.join(directory, name)
        if os.path.isfile(candidate) or config is None:
            config = candidate
        if os.path.isfile(candidate):
            break
    return config or os.path.join(directory, "config.jsonc"), \
        os.path.join(directory, "style.css")


def _bar_executable(engine):
    name = "mangobar" if engine == "mangobar" else "waybar"
    for pid in _bar_pids(engine):
        try:
            target = os.readlink("/proc/%d/exe" % pid)
            if target:
                return target
        except OSError:
            pass
    return shutil.which(name) or name


def _bar_pids(engine):
    name = "mangobar" if engine == "mangobar" else "waybar"
    try:
        out = subprocess.run(["pgrep", "-x", name], capture_output=True,
                             text=True, timeout=2)
        return [int(x) for x in out.stdout.split() if x.isdigit()]
    except (OSError, subprocess.SubprocessError, ValueError):
        return []


def _service_active(unit):
    try:
        out = subprocess.run(
            ["systemctl", "--user", "is-active", "--quiet", unit],
            timeout=2)
        return out.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def _service_exists(unit):
    try:
        out = subprocess.run(
            ["systemctl", "--user", "cat", unit],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
        return out.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def _bar_restart(engine):
    """Restart or reload a bar without sudo. Returns (ok, message)."""
    unit = "mangobar.service" if engine == "mangobar" else "waybar.service"
    if _service_active(unit):
        try:
            out = subprocess.run(["systemctl", "--user", "restart", unit],
                                 capture_output=True, text=True, timeout=10)
            if out.returncode == 0:
                return True, "Restarted " + unit
            return False, (out.stderr or out.stdout or "systemctl restart failed").strip()
        except (OSError, subprocess.SubprocessError) as ex:
            return False, str(ex)
    pids = _bar_pids(engine)
    if not pids:
        return False, "not running"
    if engine == "waybar":
        try:
            subprocess.run(["pkill", "-USR2", "-x", "waybar"], timeout=3)
            return True, "Asked Waybar to reload"
        except (OSError, subprocess.SubprocessError) as ex:
            return False, str(ex)
    exe = _bar_executable(engine)
    try:
        subprocess.run(["pkill", "-TERM", "-x", "mangobar"], timeout=3)
        deadline = time.time() + 3
        while time.time() < deadline and _bar_pids(engine):
            time.sleep(0.05)
        subprocess.Popen([exe], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        return True, "Restarted " + os.path.basename(exe)
    except (OSError, subprocess.SubprocessError) as ex:
        return False, str(ex)


def _bar_start(engine):
    unit = "mangobar.service" if engine == "mangobar" else "waybar.service"
    if _service_active(unit):
        return True, "Already running"
    if _service_exists(unit):
        try:
            out = subprocess.run(["systemctl", "--user", "start", unit],
                                 capture_output=True, text=True, timeout=10)
            if out.returncode == 0:
                return True, "Started " + unit
            return False, (out.stderr or out.stdout or "start failed").strip()
        except (OSError, subprocess.SubprocessError) as ex:
            return False, str(ex)
    if _bar_pids(engine):
        return True, "Already running"
    exe = shutil.which("mangobar" if engine == "mangobar" else "waybar")
    if not exe:
        return False, "not installed"
    try:
        subprocess.Popen([exe], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        return True, "Started " + os.path.basename(exe)
    except (OSError, subprocess.SubprocessError) as ex:
        return False, str(ex)


def _bar_stop(engine):
    unit = "mangobar.service" if engine == "mangobar" else "waybar.service"
    if _service_active(unit):
        try:
            subprocess.run(["systemctl", "--user", "stop", unit],
                           capture_output=True, text=True, timeout=10)
            return True, "Stopped " + unit
        except (OSError, subprocess.SubprocessError) as ex:
            return False, str(ex)
    if not _bar_pids(engine):
        return True, "Not running"
    try:
        subprocess.run(["pkill", "-TERM", "-x", engine], timeout=3)
        return True, "Stopped " + engine
    except (OSError, subprocess.SubprocessError) as ex:
        return False, str(ex)


def _bar_backup(path):
    if not path or not os.path.isfile(path):
        return None
    try:
        bakdir = os.path.join(os.path.dirname(path), ".autobak")
        os.makedirs(bakdir, exist_ok=True)
        stamp = time.strftime("%Y%m%d-%H%M%S")
        target = os.path.join(bakdir, stamp + "-" + os.path.basename(path))
        shutil.copy2(path, target)
        return target
    except OSError:
        return None


def _bar_config_text(engine, config, preset=None):
    title = "Waybar" if engine == "waybar" else "mangobar"
    note = "// %s configuration written by Mango Config" % title
    if preset:
        note += " — preset: " + preset
    note += ".\n// Review the file after applying; a timestamped copy is in .autobak/.\n\n"
    return note + json.dumps(config, indent=4, ensure_ascii=False) + "\n"


def _jsonc_depths(text):
    """Brace/bracket depth at every character, ignoring strings and comments."""
    depths = [0] * (len(text) + 1)
    stack = []
    in_str = False
    i, n = 0, len(text)
    while i < n:
        depths[i] = len(stack)
        c = text[i]
        if in_str:
            if c == "\\" and i + 1 < n:
                depths[i + 1] = len(stack)
                i += 2
                continue
            if c == '"':
                in_str = False
            i += 1
            continue
        if c == '"':
            in_str = True
            i += 1
            continue
        if c == "/" and i + 1 < n and text[i + 1] == "/":
            i += 2
            while i < n and text[i] != "\n":
                depths[i] = len(stack)
                i += 1
            continue
        if c == "/" and i + 1 < n and text[i + 1] == "*":
            i += 2
            while i + 1 < n and not (text[i] == "*" and text[i + 1] == "/"):
                depths[i] = len(stack)
                i += 1
            if i < n:
                depths[i] = len(stack)
            if i + 1 < n:
                depths[i + 1] = len(stack)
            i += 2
            continue
        if c in "{[":
            stack.append(c)
            depths[i] = len(stack)
            i += 1
            continue
        if c in "}]":
            if stack:
                stack.pop()
            depths[i] = len(stack)
            i += 1
            continue
        i += 1
    depths[n] = len(stack)
    return depths


def _set_jsonc_top_level(text, updates):
    """Update scalar top-level JSONC keys while keeping comments when possible.

    Only keys at the root object are touched: nested modules often repeat names
    such as ``height`` or ``interval``. The fallback reserializes the parsed
    object, so unusual formatting never silently skips a requested setting.
    """
    result = text
    for key, value in updates.items():
        value_text = json.dumps(value, ensure_ascii=False)
        pattern = re.compile(
            r'(?m)^([ \t]{0,8})"' + re.escape(key) +
            r'"([ \t]*:[ \t]*)([^\n]*?)(,?[ \t]*(?://.*)?)$')
        depths = _jsonc_depths(result)
        match = None
        for candidate in pattern.finditer(result):
            if depths[candidate.start()] == 1:
                match = candidate
                break
        if match is not None:
            result = (result[:match.start()] + '%s"%s"%s%s%s' % (
                match.group(1), key, match.group(2), value_text,
                match.group(4)) + result[match.end():])
            continue

        depths = _jsonc_depths(result)
        idx = -1
        for j in range(len(result) - 1, -1, -1):
            if result[j] == "}" and depths[j] == 0:
                idx = j
                break
        if idx < 0:
            continue
        prefix = result[:idx].rstrip()
        if prefix and not prefix.endswith(("{", ",")):
            prefix += ","
        result = prefix + '\n    "%s": %s\n' % (key, value_text) + result[idx:]
    parsed = _parse_jsonc(result)
    if parsed is None:
        old = _parse_jsonc(text, {}) or {}
        old.update(updates)
        result = json.dumps(old, indent=4, ensure_ascii=False) + "\n"
    return result


def _write_file(path, value):
    """Write text atomically without adding an extra trailing newline."""
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(value)
    os.replace(tmp, path)


def _bar_status(engine):
    unit = "mangobar.service" if engine == "mangobar" else "waybar.service"
    config, style = _bar_config_paths(engine)
    data = _read_jsonc(config, {})
    if not isinstance(data, dict):
        data = {}
    pids = _bar_pids(engine)
    service_active = _service_active(unit)
    return {
        "engine": engine,
        "unit": unit,
        "pids": pids,
        "running": bool(pids) or service_active,
        "service_active": service_active,
        "service_exists": _service_exists(unit),
        "config": config,
        "style": style,
        "config_exists": os.path.isfile(config),
        "style_exists": os.path.isfile(style),
        "height": data.get("height"),
        "layer": data.get("layer"),
        "position": data.get("position"),
    }


def _bar_apply_preset(preset):
    """Back up and write a preset's config and stylesheet."""
    engine = preset.get("engine")
    if engine not in ("mangobar", "waybar"):
        return False, "Unknown bar engine"
    config, style = _bar_config_paths(engine)
    try:
        os.makedirs(os.path.dirname(config), exist_ok=True)
        _bar_backup(config)
        _bar_backup(style)
        _write_file(config, _bar_config_text(
            engine, preset.get("config") or {}, preset.get("name")))
        _write_file(style, preset.get("css") or "")
    except OSError as ex:
        return False, str(ex)
    return True, "Wrote %s and %s" % (shortpath(config), shortpath(style))


def _bar_quick_save(engine, updates):
    """Update top-level options in an existing bar config."""
    if engine not in ("mangobar", "waybar"):
        return False, "Unknown bar engine"
    config, _style = _bar_config_paths(engine)
    if os.path.isfile(config):
        try:
            with open(config, encoding="utf-8") as fh:
                text = fh.read()
        except OSError as ex:
            return False, str(ex)
    else:
        base = MANGOBAR_BASE_CONFIG if engine == "mangobar" else WAYBAR_BASE_CONFIG
        text = _bar_config_text(engine, base)
    if _parse_jsonc(text, None) is None:
        return False, "Could not parse %s; left it unchanged" % shortpath(config)
    new_text = _set_jsonc_top_level(text, updates)
    try:
        _bar_backup(config)
        _write_file(config, new_text)
    except OSError as ex:
        return False, str(ex)
    return True, "Updated " + shortpath(config)


# ---- tiling helpers --------------------------------------------------------

TILING_BLOCK_RE = re.compile(
    r"(?ms)^[ \t]*" + re.escape(TILING_BEGIN) +
    r"[^\n]*\n.*?^[ \t]*" + re.escape(TILING_END) + r"[^\n]*(?:\n|$)")


def _layout_label(name):
    return (name or "?").replace("_", " ").title()


def _tiling_rules_from_text(text):
    """Read the managed monitor→layout rules, ignoring everything outside."""
    match = TILING_BLOCK_RE.search(text or "")
    rules = {}
    if match is None:
        return rules
    for line in match.group(0).splitlines():
        stripped = line.strip()
        if not stripped.startswith("tag_rule"):
            continue
        if "=" not in stripped:
            continue
        values = parse_kv(stripped.split("=", 1)[1])
        monitor = values.get("monitor_name")
        layout = values.get("layout_name")
        if values.get("id") == "*" and monitor and layout:
            rules[monitor] = layout
    return rules


def _tiling_text_with_rules(text, rules):
    """Replace the managed block, preserving all user content around it."""
    cleaned = TILING_BLOCK_RE.sub("", text or "")
    cleaned = re.sub(r"\n{3,}", "\n\n", cleaned).rstrip() + "\n"
    if not rules:
        return cleaned
    lines = [
        TILING_BEGIN,
        "# Managed by Mango Config's Tiling page; edits inside this block are replaced.",
    ]
    for monitor in sorted(rules):
        lines.append("tag_rule = id:*, monitor_name:%s, layout_name:%s" %
                     (monitor, rules[monitor]))
    lines.append(TILING_END)
    return cleaned + "\n" + "\n".join(lines) + "\n"


def _tiling_config_path():
    if PROFILE is not None and PROFILE.main:
        return PROFILE.main
    return os.path.join(CONFIG_DIR, "config.conf")


def _tiling_read_defaults(path=None):
    path = path or _tiling_config_path()
    try:
        with open(path, encoding="utf-8") as fh:
            return _tiling_rules_from_text(fh.read())
    except OSError:
        return {}


def _tiling_save_default(monitor, layout=None, path=None):
    """Add or remove a monitor-wide layout rule in the managed block."""
    if not monitor or any(ch in monitor for ch in ",\n\r:"):
        return False, "Invalid monitor name"
    if layout and layout not in LAYOUT_BY_NAME:
        return False, "Unknown layout: " + str(layout)
    path = path or _tiling_config_path()
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
    except OSError as ex:
        return False, str(ex)
    rules = _tiling_rules_from_text(text)
    if layout:
        rules[monitor] = layout
    else:
        rules.pop(monitor, None)
    try:
        _bar_backup(path)
        _write_file(path, _tiling_text_with_rules(text, rules))
    except OSError as ex:
        return False, str(ex)
    if layout:
        return True, "Saved %s as the default for %s" % (
            _layout_label(layout), monitor)
    return True, "Removed the managed default for " + monitor


def _mmsg_json(args, timeout=2.5):
    """Run mmsg and parse its JSON reply; None when Mango is unavailable."""
    if not shutil.which("mmsg"):
        return None
    try:
        out = subprocess.run(["mmsg"] + list(args), capture_output=True,
                             text=True, timeout=timeout)
        if out.returncode != 0:
            return None
        return json.loads(out.stdout)
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


def _mmsg_dispatch(*args):
    if not shutil.which("mmsg"):
        return False, "mmsg not found"
    payload = ",".join(str(arg) for arg in args)
    try:
        out = subprocess.run(["mmsg", "dispatch", payload],
                             capture_output=True, text=True, timeout=4)
        text = (out.stdout or out.stderr or "").strip()
        if out.returncode != 0:
            return False, text or "mmsg failed"
        try:
            data = json.loads(out.stdout)
        except ValueError:
            data = None
        if isinstance(data, dict) and data.get("error"):
            return False, str(data.get("error"))
        return True, text or "ok"
    except (OSError, subprocess.SubprocessError) as ex:
        return False, str(ex)


def _current_layout_symbol():
    """Best-effort current layout symbol for the focused monitor."""
    focused = _mmsg_json(["get", "focusing-client"])
    monitor = focused.get("monitor") if isinstance(focused, dict) else None
    if not monitor:
        data = _mmsg_json(["get", "all-monitors"]) or {}
        monitors = data.get("monitors") if isinstance(data, dict) else None
        if monitors:
            monitor = monitors[0].get("name")
    if monitor:
        data = _mmsg_json(["get", "monitor", monitor]) or {}
        symbol = data.get("layout_symbol")
        if symbol:
            return str(symbol)
    return "?"


def _discover_wallpaper_dir():
    env = os.environ.get("WALLPAPER_DIR")
    candidates = [env] if env else []
    candidates += [
        "~/Imagens/Wallpapers",
        "~/Pictures/Wallpapers",
        "~/Pictures",
        "~/Wallpapers",
    ]
    for candidate in candidates:
        path = os.path.abspath(os.path.expanduser(candidate))
        if os.path.isdir(path):
            return path
    return os.path.abspath(os.path.expanduser(env or "~/Pictures"))


WALLPAPER_DIR = _discover_wallpaper_dir()
WALLPAPER_EXTS = (".png", ".jpg", ".jpeg", ".webp", ".bmp", ".gif")


def _wallpaper_files(directory):
    try:
        names = [
            entry.path for entry in os.scandir(directory)
            if entry.is_file() and entry.name.lower().endswith(WALLPAPER_EXTS)
        ]
    except OSError:
        return []
    return sorted(names, key=lambda p: os.path.basename(p).casefold())


def _current_wallpaper():
    for path in (WALLPAPER_LINK, WALLPAPER_STATE):
        try:
            if os.path.islink(path):
                target = os.path.realpath(path)
            elif os.path.isfile(path):
                target = _read_text(path)
            else:
                continue
            if target and os.path.isfile(target):
                return target
        except OSError:
            continue
    return None


def _light_wallpaper():
    for candidate in (
            os.path.expanduser("~/.local/bin/light-wallpaper"),
            shutil.which("light-wallpaper")):
        if candidate and os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None


def _wallpaper_options():
    data = _read_json(WALLPAPER_OPTIONS)
    mode = str(data.get("mode", "fill")).lower()
    if mode not in WALLPAPER_MODES:
        mode = "fill"
    try:
        rotation = int(data.get("rotation", 0))
    except (TypeError, ValueError):
        rotation = 0
    if rotation not in (0, 90, 180, 270):
        rotation = 0
    source = data.get("source")
    if not isinstance(source, str):
        source = ""
    rendered = data.get("rendered")
    if not isinstance(rendered, str):
        rendered = ""
    return {
        "mode": mode,
        "rotation": rotation,
        "flip_h": bool(data.get("flip_h", False)),
        "flip_v": bool(data.get("flip_v", False)),
        "source": source,
        "rendered": rendered,
    }


def _save_wallpaper_options(**updates):
    data = _wallpaper_options()
    data.update(updates)
    _write_json(WALLPAPER_OPTIONS, data)
    return data


def _current_wallpaper_source():
    options = _wallpaper_options()
    source = options.get("source") or ""
    rendered = options.get("rendered") or ""
    link = _current_wallpaper()
    try:
        if link and rendered and os.path.realpath(link) == os.path.realpath(rendered):
            if source and os.path.isfile(source):
                return source
        elif link and (not rendered or os.path.realpath(link) != os.path.realpath(rendered)):
            # An external picker or helper changed the link.
            return link
    except OSError:
        pass
    if source and os.path.isfile(source):
        return source
    return link


def _display_size():
    try:
        disp = Gdk.Display.get_default()
        monitors = disp.get_monitors() if disp is not None else None
        if monitors is not None and monitors.get_n_items() > 0:
            mon = monitors.get_item(0)
            geom = mon.get_geometry()
            scale = mon.get_scale_factor() or 1
            width = max(1, int(geom.width * scale))
            height = max(1, int(geom.height * scale))
            if width > 1 and height > 1:
                return width, height
    except Exception:
        pass
    return 1920, 1080


def _fit_target_size(width, height, max_width, max_height):
    width = max(1, int(width))
    height = max(1, int(height))
    ratio = min(max_width / float(width), max_height / float(height), 1.0)
    return max(1, int(round(width * ratio))), max(1, int(round(height * ratio)))


def _compose_wallpaper(pb, mode, rotation, flip_h, flip_v, width, height):
    """Return a pixbuf composited for the requested mode and screen size."""
    if GdkPixbuf is None:
        raise RuntimeError("GdkPixbuf is not available")
    if mode not in WALLPAPER_MODES:
        mode = "fill"
    if rotation == 90:
        pb = pb.rotate_simple(GdkPixbuf.PixbufRotation.CLOCKWISE)
    elif rotation == 180:
        pb = pb.rotate_simple(GdkPixbuf.PixbufRotation.UPSIDEDOWN)
    elif rotation == 270:
        pb = pb.rotate_simple(GdkPixbuf.PixbufRotation.COUNTERCLOCKWISE)
    if flip_h:
        pb = pb.flip(True)
    if flip_v:
        pb = pb.flip(False)
    w, h = pb.get_width(), pb.get_height()
    W, H = max(1, int(width)), max(1, int(height))
    canvas = GdkPixbuf.Pixbuf.new(GdkPixbuf.Colorspace.RGB, True, 8, W, H)
    canvas.fill(0x000000ff)
    interp = GdkPixbuf.InterpType.BILINEAR
    if mode == "stretch":
        scaled = pb.scale_simple(W, H, interp)
        scaled.composite(canvas, 0, 0, W, H, 0, 0, 1, 1, interp, 255)
    elif mode == "fill":
        if w * H > h * W:
            crop_w, crop_h = max(1, int(round(h * W / float(H)))), h
        else:
            crop_w, crop_h = w, max(1, int(round(w * H / float(W))))
        crop = pb.new_subpixbuf((w - crop_w) // 2, (h - crop_h) // 2,
                                crop_w, crop_h)
        scaled = crop.scale_simple(W, H, interp)
        scaled.composite(canvas, 0, 0, W, H, 0, 0, 1, 1, interp, 255)
    elif mode == "fit":
        scale = min(W / float(w), H / float(h))
        sw, sh = max(1, int(round(w * scale))), max(1, int(round(h * scale)))
        scaled = pb.scale_simple(sw, sh, interp)
        x, y = (W - sw) // 2, (H - sh) // 2
        scaled.composite(canvas, x, y, sw, sh, 0, 0, 1, 1, interp, 255)
    elif mode == "center":
        cw, ch = min(w, W), min(h, H)
        crop = pb.new_subpixbuf((w - cw) // 2, (h - ch) // 2, cw, ch)
        x, y = (W - cw) // 2, (H - ch) // 2
        crop.composite(canvas, x, y, cw, ch, 0, 0, 1, 1, interp, 255)
    else:  # tile
        for y in range(0, H, h):
            for x in range(0, W, w):
                tw, th = min(w, W - x), min(h, H - y)
                part = pb if (tw, th) == (w, h) else pb.new_subpixbuf(0, 0, tw, th)
                part.composite(canvas, x, y, tw, th, 0, 0, 1, 1, interp, 255)
    return canvas


def _save_wallpaper_pixbuf(pb, path=None):
    path = path or WALLPAPER_RENDERED
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    pb.savev(path, "png", [], [])
    return path


def _render_wallpaper(source, options, width=None, height=None, path=None):
    if GdkPixbuf is None:
        raise RuntimeError("GdkPixbuf is not available")
    if not source or not os.path.isfile(source):
        raise OSError("wallpaper file not found: %s" % (source or ""))
    if width is None or height is None:
        width, height = _display_size()
    pb = GdkPixbuf.Pixbuf.new_from_file(source)
    canvas = _compose_wallpaper(
        pb, options.get("mode", "fill"), options.get("rotation", 0),
        options.get("flip_h", False), options.get("flip_v", False),
        width, height)
    if path:
        _save_wallpaper_pixbuf(canvas, path)
    return canvas


def _desktop_app_dirs():
    dirs = []
    data_home = os.environ.get("XDG_DATA_HOME") or "~/.local/share"
    candidates = [
        os.path.expanduser(data_home),
        os.path.expanduser("~/.local/share/flatpak/exports/share"),
        "/usr/local/share",
        "/usr/share",
    ]
    for value in (os.environ.get("XDG_DATA_DIRS") or "").split(":"):
        if value:
            candidates.append(value)
    candidates.append("/var/lib/flatpak/exports/share")
    for base in candidates:
        path = os.path.abspath(os.path.expanduser(base))
        appdir = os.path.join(path, "applications")
        if appdir not in dirs:
            dirs.append(appdir)
    return dirs


def _parse_desktop_entry(text, desktop_id):
    section = ""
    fields = {}
    for raw in (text or "").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1].strip()
            continue
        if section != "Desktop Entry" or "=" not in line:
            continue
        key, value = line.split("=", 1)
        fields[key.strip()] = value.strip()
    if not fields.get("Name"):
        return None
    if fields.get("Hidden", "").lower() == "true":
        return None
    if fields.get("NoDisplay", "").lower() == "true":
        return None
    return {
        "id": desktop_id,
        "name": fields.get("Name", desktop_id),
        "exec": fields.get("Exec", ""),
        "icon": fields.get("Icon", ""),
        "terminal": fields.get("Terminal", "").lower() == "true",
        "categories": {p.lower() for p in fields.get("Categories", "").split(";") if p},
        "mimes": {p.lower() for p in fields.get("MimeType", "").split(";") if p},
    }


def _desktop_apps():
    apps = {}
    seen = set()
    for directory in _desktop_app_dirs():
        try:
            entries = sorted(os.scandir(directory), key=lambda e: e.name.casefold())
        except OSError:
            continue
        for entry in entries:
            if not entry.is_file() or not entry.name.endswith(".desktop"):
                continue
            if entry.name in seen:
                continue
            seen.add(entry.name)
            try:
                text = open(entry.path, encoding="utf-8", errors="replace").read()
            except OSError:
                continue
            app = _parse_desktop_entry(text, entry.name)
            if app:
                apps[app["id"]] = app
    return sorted(apps.values(), key=lambda a: (a["name"].casefold(), a["id"]))


def _desktop_apps_for_role(apps, role):
    terminal_ids = {x.lower() for x in TERMINAL_DESKTOP_IDS}
    file_ids = {x.lower() for x in FILE_MANAGER_DESKTOP_IDS}
    browser_ids = {x.lower() for x in BROWSER_DESKTOP_IDS}
    picked = []
    for app in apps:
        aid = app["id"].lower()
        if role == "terminal":
            match = "terminalemulator" in app["categories"] or aid in terminal_ids
        elif role == "files":
            match = "filemanager" in app["categories"] or aid in file_ids
        else:
            match = "webbrowser" in app["categories"] or aid in browser_ids
        if match:
            picked.append(app)
    return picked


def _mimeapps_defaults(path=None):
    path = path or DEFAULT_APPS_FILE
    entries = {}
    section = ""
    try:
        lines = open(path, encoding="utf-8").read().splitlines()
    except OSError:
        return entries
    for raw in lines:
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1].strip()
            continue
        if section == "Default Applications" and "=" in line:
            key, value = line.split("=", 1)
            values = [p.strip() for p in value.split(";") if p.strip()]
            if values:
                entries[key.strip()] = values[0]
    return entries


def _mimeapps_lookup(mimes, path=None):
    entries = _mimeapps_defaults(path)
    for mime in mimes:
        if entries.get(mime):
            return entries[mime]
    return ""


def _mimeapps_set_defaults(text, values):
    lines = (text or "").splitlines()
    start = None
    end = None
    for i, raw in enumerate(lines):
        line = raw.strip()
        if line == "[Default Applications]":
            start = i
            end = len(lines)
        elif start is not None and line.startswith("[") and line.endswith("]"):
            end = i
            break
    if start is None:
        if lines and lines[-1].strip():
            lines.append("")
        lines.append("[Default Applications]")
        start = len(lines) - 1
        end = len(lines)
    region = lines[start + 1:end]
    out = []
    seen = set()
    for raw in region:
        line = raw.strip()
        key = line.split("=", 1)[0].strip() if line and not line.startswith("#") and "=" in line else None
        if key in values:
            if key not in seen:
                out.append("%s=%s;" % (key, values[key].rstrip(";")))
                seen.add(key)
            continue
        out.append(raw)
    for key, value in values.items():
        if key not in seen:
            out.append("%s=%s;" % (key, value.rstrip(";")))
    lines[start + 1:end] = out
    return "\n".join(lines).rstrip("\n") + "\n"


def _backup_mimeapps(path):
    if not path or not os.path.isfile(path):
        return None
    backup_dir = os.path.join(APP_STATE_DIR, "backups")
    try:
        os.makedirs(backup_dir, exist_ok=True)
        target = os.path.join(
            backup_dir, "mimeapps-%s.list" % time.strftime("%Y%m%d-%H%M%S"))
        shutil.copy2(path, target)
        return target
    except OSError:
        return None


def _save_default_apps(values):
    path = DEFAULT_APPS_FILE
    try:
        old = open(path, encoding="utf-8").read()
    except OSError:
        old = ""
    new = _mimeapps_set_defaults(old, values)
    if new == old:
        return False, "No changes"
    _backup_mimeapps(path)
    try:
        parent = os.path.dirname(path)
        if parent:
            os.makedirs(parent, exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write(new)
        os.replace(tmp, path)
    except OSError as ex:
        return False, str(ex)
    return True, "Saved"


def _light_night():
    for candidate in (
            os.path.expanduser("~/.local/bin/light-night"),
            shutil.which("light-night")):
        if candidate and os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None


def _brightness_number(text):
    m = re.search(r"-?\d+(?:\.\d+)?", text or "")
    if not m:
        return None
    try:
        return float(m.group(0))
    except ValueError:
        return None


def _brightness_parse(text):
    value = _brightness_number(text)
    if value is None:
        return None
    return max(0, min(100, int(round(value))))


def _brightness_helper():
    for candidate in (
            os.path.expanduser("~/.local/bin/light-brightness"),
            shutil.which("light-brightness")):
        if candidate and os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None


def _brightness_sysfs_devices():
    root = "/sys/class/backlight"
    try:
        names = sorted(os.listdir(root))
    except OSError:
        return []
    return [os.path.join(root, name) for name in names
            if os.path.isfile(os.path.join(root, name, "brightness"))]


def _brightness_backends():
    backends = []
    helper = _brightness_helper()
    if helper:
        backends.append({"kind": "helper", "label": "light-brightness (DDC/CI)",
                         "command": helper})
    bc = shutil.which("brightnessctl")
    if bc:
        backends.append({"kind": "brightnessctl", "label": "brightnessctl",
                         "command": bc})
    light = shutil.which("light")
    if light:
        devices = _brightness_sysfs_devices()
        backends.append({"kind": "light", "label": "light",
                         "command": light,
                         "device": os.path.basename(devices[0]) if devices else ""})
    for device in _brightness_sysfs_devices():
        backends.append({"kind": "sysfs", "label": "sysfs backlight",
                         "device": device})
    return backends


def _brightness_read(backend):
    kind = backend.get("kind")
    try:
        if kind == "helper":
            proc = subprocess.run(
                [backend["command"], "get"], capture_output=True, text=True,
                timeout=8)
            if proc.returncode != 0:
                return None, (proc.stderr or "brightness helper failed").strip()
            value = _brightness_parse(proc.stdout)
            return (value, "") if value is not None else (None, "unreadable brightness")
        if kind == "brightnessctl":
            cur = subprocess.run(
                [backend["command"], "g"], capture_output=True, text=True,
                timeout=4)
            cap = subprocess.run(
                [backend["command"], "m"], capture_output=True, text=True,
                timeout=4)
            if cur.returncode != 0 or cap.returncode != 0:
                return None, (cur.stderr or cap.stderr or "brightnessctl failed").strip()
            current = _brightness_number(cur.stdout)
            maximum = _brightness_number(cap.stdout)
            if current is None or not maximum:
                return None, "unreadable brightnessctl values"
            return max(0, min(100, int(round(current * 100.0 / maximum)))), ""
        if kind == "light":
            cmd = [backend["command"]]
            if backend.get("device"):
                cmd += ["-s", backend["device"]]
            proc = subprocess.run(cmd + ["-G"], capture_output=True, text=True,
                                  timeout=4)
            if proc.returncode != 0:
                return None, (proc.stderr or "light failed").strip()
            value = _brightness_parse(proc.stdout)
            return (value, "") if value is not None else (None, "unreadable brightness")
        if kind == "sysfs":
            with open(os.path.join(backend["device"], "brightness"), encoding="utf-8") as fh:
                current = int(fh.read().strip())
            with open(os.path.join(backend["device"], "max_brightness"), encoding="utf-8") as fh:
                maximum = int(fh.read().strip())
            if maximum <= 0:
                return None, "invalid backlight maximum"
            return max(0, min(100, int(round(current * 100.0 / maximum)))), ""
    except (OSError, ValueError, subprocess.SubprocessError) as ex:
        return None, str(ex)
    return None, "unsupported brightness backend"


def _brightness_probe():
    errors = []
    for backend in _brightness_backends():
        value, error = _brightness_read(backend)
        if value is not None:
            return backend, value, ""
        if error:
            errors.append("%s: %s" % (backend.get("label", "backend"), error))
    return None, None, "; ".join(errors) or "no brightness backend found"


def _brightness_set(backend, percent):
    percent = max(0, min(100, int(percent)))
    kind = backend.get("kind")
    try:
        if kind == "helper":
            cmd = [backend["command"], "set", str(percent)]
        elif kind == "brightnessctl":
            cmd = [backend["command"], "set", "%d%%" % percent]
        elif kind == "light":
            cmd = [backend["command"]]
            if backend.get("device"):
                cmd += ["-s", backend["device"]]
            cmd += ["-S", str(percent)]
        elif kind == "sysfs":
            with open(os.path.join(backend["device"], "max_brightness"),
                      encoding="utf-8") as fh:
                maximum = int(fh.read().strip())
            raw = max(0, min(maximum, int(round(maximum * percent / 100.0))))
            with open(os.path.join(backend["device"], "brightness"),
                      "w", encoding="utf-8") as fh:
                fh.write(str(raw))
            return True, percent
        else:
            return False, "unsupported brightness backend"
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
        if proc.returncode != 0:
            detail = (proc.stderr or proc.stdout or "exit code %s" % proc.returncode).strip()
            return False, detail.splitlines()[-1]
        return True, percent
    except (OSError, ValueError, subprocess.SubprocessError) as ex:
        return False, str(ex)


def _night_marker():
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
    return os.path.join(runtime, "mango-night-mode")


def _sync_night_marker(enabled):
    # A common optional keybind helper (light-night) uses this runtime marker
    # to decide whether its next invocation turns the effect on or off. Keep
    # that marker in sync when that helper is installed; other setups ignore it.
    if not _light_night():
        return
    marker = _night_marker()
    try:
        if enabled:
            open(marker, "a").close()
        elif os.path.exists(marker):
            os.unlink(marker)
    except OSError:
        pass


def _nightlight_process():
    try:
        out = subprocess.run(
            ["pgrep", "-x", "gammastep"], capture_output=True, text=True,
            timeout=2)
    except (OSError, subprocess.SubprocessError):
        return False, None
    for pid in (out.stdout or "").split():
        try:
            raw = open("/proc/%s/cmdline" % pid, "rb").read()
        except OSError:
            continue
        args = [a.decode("utf-8", "ignore") for a in raw.split(b"\0") if a]
        temp = None
        for i, arg in enumerate(args):
            if arg in ("-O", "--temperature") and i + 1 < len(args):
                try:
                    temp = int(args[i + 1])
                except ValueError:
                    pass
            elif arg.startswith("--temperature="):
                try:
                    temp = int(arg.split("=", 1)[1])
                except ValueError:
                    pass
        return True, temp
    return False, None


def _set_nightlight(enabled, temperature):
    gammastep = shutil.which("gammastep")
    if not gammastep:
        return False, "gammastep is not installed"
    try:
        subprocess.run(
            ["systemctl", "--user", "stop", "gammastep.service"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=4)
    except (OSError, subprocess.SubprocessError):
        pass
    try:
        subprocess.run(
            ["pkill", "-x", "gammastep"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
    except (OSError, subprocess.SubprocessError):
        pass
    if enabled:
        try:
            subprocess.Popen(
                [gammastep, "-m", "wayland", "-O", str(int(temperature))],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True)
        except OSError as ex:
            return False, "could not start gammastep: %s" % ex
        time.sleep(0.35)
        running, actual = _nightlight_process()
        if not running:
            return False, "gammastep did not stay running"
        _write_json(NIGHT_STATE, {"enabled": True,
                                  "temperature": actual or int(temperature)})
        _sync_night_marker(True)
        return True, "Night light on · %sK" % (actual or int(temperature))
    _write_json(NIGHT_STATE, {"enabled": False, "temperature": int(temperature)})
    _sync_night_marker(False)
    return True, "Night light off"


def _expand_source(value, config_dir):
    v = value.strip().strip('"').strip("'")
    home = os.path.expanduser("~")
    v = v.replace("${HOME}", home).replace("$HOME", home)
    if v.startswith("~"):
        v = os.path.expanduser(v)
    elif v.startswith("./"):
        v = os.path.join(config_dir, v[2:])
    elif not os.path.isabs(v):
        guess = os.path.join(config_dir, v)
        v = guess if os.path.exists(guess) else v
    return os.path.normpath(v)


def _file_keys(path):
    keys = []
    for line in read_lines(path):
        st = line.strip()
        if not st or st.startswith("#") or st.startswith("["):
            continue
        m = KEY_RE.match(st)
        if m:
            keys.append(m.group(1))
    return keys


class Profile:
    def __init__(self, config_dir):
        self.dir = config_dir
        self.main = os.path.join(config_dir, "config.conf")
        self.toml = os.path.join(config_dir, "config.toml")
        self.files = []
        self.paths = {role: None for role in
                      ("layout", "input", "cursor", "outputs", "rules", "binds",
                       "colors", "theme")}
        self.dms = False
        self.error = ""
        self.warnings = []

    def path(self, role):
        return self.paths.get(role)


def _collect_included_files(profile):
    seen = set()
    ordered = []

    def visit(path):
        real = os.path.realpath(path)
        if real in seen or not os.path.isfile(path):
            return
        seen.add(real)
        ordered.append(path)
        if path.lower().endswith(".toml"):
            return
        for line in read_lines(path):
            st = line.strip()
            if not st or st.startswith("#"):
                continue
            m = re.match(r"^(source_optional|source)\s*=\s*(.+)$", st)
            if not m:
                continue
            raw = m.group(2).strip()
            if "$" in raw and "$HOME" not in raw and "${HOME}" not in raw:
                profile.warnings.append("Skipped source with unresolved variable: " + raw)
                continue
            visit(_expand_source(raw, profile.dir))

    if os.path.isfile(profile.main):
        visit(profile.main)
    profile.files = ordered


def discover_profile(config_dir):
    profile = Profile(config_dir)
    if not os.path.isfile(profile.main):
        if os.path.isfile(profile.toml):
            profile.error = ("Mango is using config.toml, which this version does not "
                             "edit yet. Use config.conf or convert the TOML file.")
        else:
            profile.error = "No config.conf found in " + shortpath(config_dir)
        return profile

    _collect_included_files(profile)
    key_map = {p: _file_keys(p) for p in profile.files}

    for role in ("layout", "input", "cursor", "outputs", "rules", "binds"):
        scored = []
        for idx, path in enumerate(profile.files):
            keys = key_map.get(path, [])
            if role == "binds":
                n = sum(1 for k in keys if k.lower().startswith("bind"))
            else:
                n = sum(1 for k in keys if k in ROLE_KEYS[role])
            if n:
                scored.append((n, idx, path))
        if scored:
            scored.sort(key=lambda t: (t[0], t[1]))
            profile.paths[role] = scored[-1][2]
        else:
            for name in FLAT_NAMES[role]:
                cand = os.path.join(profile.dir, name)
                if cand in profile.files:
                    profile.paths[role] = cand
                    break
            if profile.paths[role] is None:
                for path in profile.files:
                    if os.path.basename(path) in FLAT_NAMES[role]:
                        profile.paths[role] = path

    base_keys = {"border_color", "focus_color", "urgent_color"}
    base_scored = []
    for idx, path in enumerate(profile.files):
        n = sum(1 for k in key_map.get(path, []) if k in base_keys)
        if n:
            base_scored.append((n, idx, path))
    if base_scored:
        base_scored.sort(key=lambda t: (t[0], t[1]))
        profile.paths["colors"] = base_scored[-1][2]
    else:
        for name in FLAT_NAMES["colors"]:
            cand = os.path.join(profile.dir, name)
            if cand in profile.files:
                profile.paths["colors"] = cand
                break

    theme_scored = []
    for idx, path in enumerate(profile.files):
        keys = key_map.get(path, [])
        n = sum(1 for k in keys if k.endswith("_color") and k not in base_keys)
        if n:
            priority = 1 if re.search(r"theme|noctalia|color", os.path.basename(path), re.I) else 0
            theme_scored.append((n, priority, idx, path))
    if theme_scored:
        theme_scored.sort(key=lambda t: (t[0], t[1], t[2]))
        profile.paths["theme"] = theme_scored[-1][3]
    else:
        for name in FLAT_NAMES["theme"]:
            cand = os.path.join(profile.dir, name)
            if cand in profile.files:
                profile.paths["theme"] = cand
                break

    dms_prefix = os.path.join(profile.dir, "dms") + os.sep
    profile.dms = any(p and p.startswith(dms_prefix) for p in profile.paths.values())
    return profile


def configure_profile(profile):
    global CONFIG_DIR, LAYOUT, NOCTALIA, COLORS, INPUT, CURSOR, OUTPUTS, WINDOWRULES, BINDS, PROFILE
    PROFILE = profile
    CONFIG_DIR = profile.dir
    LAYOUT = profile.paths.get("layout")
    NOCTALIA = profile.paths.get("theme")
    COLORS = profile.paths.get("colors")
    INPUT = profile.paths.get("input")
    CURSOR = profile.paths.get("cursor")
    OUTPUTS = profile.paths.get("outputs")
    WINDOWRULES = profile.paths.get("rules")
    BINDS = profile.paths.get("binds")


def read_lines(path):
    if not path:
        return []
    try:
        with open(path, encoding="utf-8") as f:
            return f.readlines()
    except FileNotFoundError:
        return []


def write_lines(path, lines):
    if not path:
        return
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.writelines(lines)


KEY_RE = re.compile(r"^([A-Za-z0-9_]+)\s*=\s*(.*)$")


def set_simple(lines, key, new_value, sep="="):
    out, replaced = [], False
    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            out.append(line)
            continue
        m = KEY_RE.match(stripped)
        if m and m.group(1) == key:
            lead = line[: len(line) - len(line.lstrip())]
            trail = ""
            out.append(f"{lead}{key}{sep}{new_value}{trail}\n")
            replaced = True
        else:
            out.append(line)
    if not replaced:
        out.append(f"{key}{sep}{new_value}\n")
    return out


def key_sep(lines, key, default="="):
    pat = re.compile(r"^\s*" + re.escape(key) + r"(\s*=\s*)")
    for line in lines:
        m = pat.match(line)
        if m:
            return m.group(1)
    return default


def fmt_float(v):
    text = ("%.2f" % float(v)).rstrip("0").rstrip(".")
    return text if text not in ("", "-") else "0"


def get_simple(lines, key, default=None):
    for line in lines:
        m = KEY_RE.match(line.strip())
        if m and m.group(1) == key:
            return m.group(2).strip()
    return default


def parse_kv(value):
    d = {}
    for part in value.split(","):
        part = part.strip()
        if ":" in part:
            k, v = part.split(":", 1)
            d[k.strip()] = v.strip()
    return d


def build_kv(d, order):
    return ",".join(f"{k}:{d.get(k, '')}" for k in order if k in d)


def set_kv_line(lines, prefix, new_dict, order):
    out, replaced = [], False
    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            out.append(line)
            continue
        if stripped.startswith(prefix + "="):
            old = stripped[len(prefix) + 1:]
            merged = parse_kv(old)
            merged.update(new_dict)
            lead = line[: len(line) - len(line.lstrip())]
            trail = ""
            out.append(f"{lead}{prefix}={build_kv(merged, order)}{trail}\n")
            replaced = True
        else:
            out.append(line)
    if not replaced:
        out.append(f"{prefix}={build_kv(new_dict, order)}\n")
    return out


def hex_to_rgba(h):
    h = (h or "").strip()
    if h.lower().startswith("0x"):
        h = h[2:]
    elif h.startswith("#"):
        h = h[1:]
    if len(h) == 6:
        h = h + "ff"
    h = "#" + h
    rgba = Gdk.RGBA()
    rgba.parse(h)
    return rgba


def rgba_to_hex(rgba):
    return "0x%02x%02x%02x%02x" % (int(rgba.red * 255), int(rgba.green * 255),
                                  int(rgba.blue * 255), int(rgba.alpha * 255))


def rgba_display(rgba):
    r = int(round(rgba.red * 255))
    g = int(round(rgba.green * 255))
    b = int(round(rgba.blue * 255))
    a = int(round(rgba.alpha * 255))
    if a >= 255:
        return "#%02X%02X%02X" % (r, g, b)
    return "#%02X%02X%02X%02X" % (r, g, b, a)


def discover_cursor_themes():
    themes = []
    seen = set()
    dirs = [
        os.path.expanduser("~/.icons"),
        os.path.expanduser("~/.local/share/icons"),
        "/usr/share/icons",
        "/usr/local/share/icons",
    ]
    for d in dirs:
        if not os.path.isdir(d):
            continue
        try:
            names = sorted(os.listdir(d))
        except Exception:
            continue
        for name in names:
            if name in seen:
                continue
            p = os.path.join(d, name)
            if not os.path.isdir(p):
                continue
            if os.path.isdir(os.path.join(p, "cursors")) or os.path.isfile(os.path.join(p, "cursor.theme")):
                seen.add(name)
                themes.append(name)
    return themes


class Row(Gtk.Box):
    def __init__(self, label, widget):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.set_margin_top(6)
        self.set_margin_bottom(6)
        self.set_hexpand(True)
        self.set_valign(Gtk.Align.CENTER)
        lbl = Gtk.Label(label=label)
        lbl.set_halign(Gtk.Align.START)
        lbl.set_hexpand(True)
        lbl.set_xalign(0)
        self.append(lbl)
        widget.set_hexpand(False)
        widget.set_halign(Gtk.Align.END)
        self.append(widget)


class Section(Gtk.Box):
    def __init__(self, title):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.set_margin_top(10)
        self.set_margin_start(12)
        self.set_margin_end(12)
        self.set_margin_bottom(6)
        lbl = Gtk.Label(label=title)
        lbl.add_css_class("title")
        lbl.set_halign(Gtk.Align.START)
        self.append(lbl)
        self.append(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL))
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.box.set_hexpand(True)
        self.append(self.box)

    def add_row(self, label, widget):
        self.box.append(Row(label, widget))


