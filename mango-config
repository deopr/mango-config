    def detect_outputs(self):
        import glob as _glob
        import json as _json
        import socket as _socket
        for sp in _glob.glob("/run/user/%d/mango-*.sock" % os.getuid()):
            try:
                s = _socket.socket(_socket.AF_UNIX, _socket.SOCK_STREAM)
                s.settimeout(1.5)
                s.connect(sp)
                s.sendall(b"get all-monitors\n")
                data = s.recv(262144)
                s.close()
                obj = _json.loads(data.decode("utf-8", "replace") or "{}")
                mons = [m for m in obj.get("monitors", []) if m.get("active")]
                if mons:
                    return mons
            except (OSError, ValueError):
                continue
        return []

    def _monitor_for_name(self, name):
        if not name:
            return None
        for m in getattr(self, "_detected_outputs", []):
            out = str(m.get("name", ""))
            try:
                if re.fullmatch(name, out):
                    return m
            except re.error:
                if name == out:
                    return m
        return None

