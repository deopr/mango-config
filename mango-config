    def _monitor_line(self, e):
        kv = dict(e.get("extra") or {})
        present = e.get("keys") or set()
        name = e["name"].get_text().strip()
        if name:
            kv["name"] = name
        for key in ("width", "height"):
            v = int(e["spins"][key].get_value())
            if v > 0 or key in present:
                kv[key] = str(v)
        refr = e["spins"]["refresh"].get_value()
        if refr > 0 or "refresh" in present:
            kv["refresh"] = ("%.2f" % refr).rstrip("0").rstrip(".")
        for key in ("x", "y"):
            v = int(e["spins"][key].get_value())
            if v != 0 or key in present:
                kv[key] = str(v)
        sc = e["spins"]["scale"].get_value()
        if abs(sc - 1.0) > 0.001 or "scale" in present:
            kv["scale"] = ("%.2f" % sc).rstrip("0").rstrip(".") or "1"
        rsel = e["rr"].get_selected()
        if rsel or "rr" in present:
            kv["rr"] = str(rsel)
        for key, cb in e["sw"].items():
            if cb.get_active() or key in present:
                kv[key] = "1" if cb.get_active() else "0"
        if not name and not any(k in kv for k in ("make", "model", "serial")):
            return None
        order = ["name", "make", "model", "serial", "width", "height", "refresh", "x", "y",
                 "scale", "rr", "vrr", "hdr", "primary", "disable", "custom",
                 "hdr_min_lum", "hdr_max_lum", "hdr_max_avg_lum", "hdr_force", "icc"]
        keys = [k for k in order if k in kv] + [k for k in kv if k not in order]
        return ",".join("%s:%s" % (k, kv[k]) for k in keys)

