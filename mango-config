    def _tiling_selected_monitor(self):
        names = getattr(self, "tiling_monitor_names", [])
        dropdown = getattr(self, "tiling_target_dd", None)
        if dropdown is None or not names:
            return None
        index = dropdown.get_selected()
        if 0 <= index < len(names):
            return names[index]
        return names[0]

    def _tiling_update_target_info(self):
        if not hasattr(self, "tiling_target_label"):
            return
        monitor = self._tiling_selected_monitor()
        data = getattr(self, "tiling_monitor_data", {}).get(monitor)
        if not data:
            self.tiling_target_label.set_text(
                "No monitor selected. Start Mango or refresh.")
            return
        symbol = data.get("layout_symbol", "?")
        name = LAYOUT_SYMBOL_NAME.get(symbol)
        active = data.get("active_tags") or []
        label = "%s · tag %s · %s (%s)" % (
            monitor,
            ", ".join(str(t) for t in active) if active else "?",
            _layout_label(name) if name else "unknown",
            symbol)
        self.tiling_target_label.set_text(label)

    def _tiling_mark_cards(self):
        monitor = self._tiling_selected_monitor()
        data = getattr(self, "tiling_monitor_data", {}).get(monitor, {})
        symbol = data.get("layout_symbol")
        current = LAYOUT_SYMBOL_NAME.get(symbol)
        for name, button in getattr(self, "tiling_layout_buttons", {}).items():
            if name == current:
                button.add_css_class("current")
            else:
                button.remove_css_class("current")
        for name, card in getattr(self, "tiling_live_cards", {}).items():
            if name == monitor:
                card.add_css_class("selected-monitor")
            else:
                card.remove_css_class("selected-monitor")

    def _tiling_sync_default_choice(self):
        monitor = self._tiling_selected_monitor()
        rules = getattr(self, "tiling_defaults", {})
        data = getattr(self, "tiling_monitor_data", {}).get(monitor, {})
        symbol = data.get("layout_symbol")
        layout = rules.get(monitor) or LAYOUT_SYMBOL_NAME.get(symbol) or "tile"
        names = [name for name, _s, _f, _d in LAYOUT_INFO]
        if layout in names:
            self.tiling_default_dd.set_selected(names.index(layout))
        self.tiling_remove_btn.set_sensitive(monitor in rules)
        self.tiling_target_label.set_tooltip_text(
            "The default is a managed tag_rule in config.conf; runtime changes "
            "above only affect the current tag.")

    def _tiling_refresh_defaults(self):
        rules = _tiling_read_defaults()
        self.tiling_defaults = rules
        if rules:
            text = "\n".join("• %s → %s (%s)" % (
                monitor, _layout_label(layout), layout)
                for monitor, layout in sorted(rules.items()))
        else:
            text = ("No managed defaults yet. Pick a layout above, then save it "
                    "to make it survive Mango restarts.")
        self.tiling_defaults_label.set_text(text)
        self._tiling_sync_default_choice()

    def _tiling_target_changed(self, *_args):
        if getattr(self, "_tiling_updating", False):
            return
        monitor = self._tiling_selected_monitor()
        if monitor:
            self.tiling_selected_name = monitor
        self._tiling_update_target_info()
        self._tiling_mark_cards()
        self._tiling_sync_default_choice()

