    def apply_nightlight(self, _b=None):
        enabled = self.night_sw.get_active()
        temperature = int(round(self.night_scale.get_value()))
        self.night_apply.set_sensitive(False)
        self.night_status.set_text("Applying…")

        def worker():
            ok, message = _set_nightlight(enabled, temperature)
            GLib.idle_add(self._nightlight_done, ok, message, enabled, temperature)

        threading.Thread(target=worker, daemon=True).start()

    def _nightlight_done(self, ok, message, enabled, temperature):
        running, current = _nightlight_process()
        self.night_sw.set_active(running)
        if running and current is not None:
            self.night_scale.set_value(current)
        elif not running:
            self.night_scale.set_value(temperature)
        self.night_apply.set_sensitive(True)
        self.night_status.set_text(message)
        return False

