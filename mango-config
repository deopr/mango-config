    def b_layout(self):
        specs = [
            ("Border radius", "border_radius", 0, 128, "int", LAYOUT),
            ("Border width (px)", "border_px", 0, 32, "int", LAYOUT),
            ("Inner gap (h)", "gap_inner_horizontal", 0, 128, "int", LAYOUT),
            ("Inner gap (v)", "gap_inner_vertical", 0, 128, "int", LAYOUT),
            ("Outer gap (h)", "gap_outer_horizontal", 0, 128, "int", LAYOUT),
            ("Outer gap (v)", "gap_outer_vertical", 0, 128, "int", LAYOUT),
        ]
        if not LAYOUT or not os.path.isfile(LAYOUT):
            return self._empty_page("No layout file found. Add layout settings to config.conf or source a layout file from it.")
        lines = read_lines(LAYOUT)
        if not any(get_simple(lines, key) is not None for _l, key, *_r in specs):
            return self._empty_page("No layout settings found in " + shortpath(LAYOUT) + ".")
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        page.set_hexpand(True)
        page.set_vexpand(True)
        s = Section("Spacing & borders")
        for label, key, lo, hi, kind, path in specs:
            sb = self._spin(float(get_simple(lines, key, 0)), lo, hi, 1)
            s.add_row(label, sb)
            self.field(sb, kind, path, key)
        page.append(s)
        raw = Gtk.Expander(label="Raw configuration")
        raw.set_expanded(False)
        preview = Gtk.Label(label="\n".join(l.strip() for l in lines if l.strip() and not l.strip().startswith("#")))
        preview.add_css_class("mono-raw")
        preview.set_wrap(True)
        preview.set_xalign(0)
        preview.set_selectable(True)
        preview.set_margin_top(6)
        raw.set_child(preview)
        page.append(raw)
        return page

    def _color_card(self, title, key, path, lines, desc=None):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        card.add_css_class("color-card")
        btn = self._color(get_simple(lines, key))
        btn.add_css_class("color-swatch")
        btn.set_tooltip_text(key)
        btn.set_size_request(-1, 46)
        hexlbl = Gtk.Label()
        hexlbl.add_css_class("color-hex")
        hexlbl.set_xalign(0)

        def update(*_a):
            try:
                hexlbl.set_text(rgba_display(btn.get_rgba()))
            except Exception:
                hexlbl.set_text("")
        btn.connect("notify::rgba", update)
        update()

        name = Gtk.Label(label=title)
        name.add_css_class("color-name")
        name.set_xalign(0)
        name.set_ellipsize(Pango.EllipsizeMode.END)
        name.set_tooltip_text(title)
        card.append(btn)
        card.append(name)
        if desc:
            d = Gtk.Label(label=desc)
            d.add_css_class("dim-label")
            d.set_xalign(0)
            d.set_wrap(True)
            card.append(d)
        card.append(hexlbl)
        self.field(btn, "color", path, key)
        return card

    def _color_flow(self, max_per_line=4):
        flow = Gtk.FlowBox()
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_max_children_per_line(max_per_line)
        flow.set_min_children_per_line(1)
        flow.set_column_spacing(10)
        flow.set_row_spacing(10)
        flow.set_homogeneous(True)
        flow.set_valign(Gtk.Align.START)
        return flow

    def _color_group_label(self, title):
        lbl = Gtk.Label(label=title.upper())
        lbl.add_css_class("color-group")
        lbl.set_xalign(0)
        return lbl

    def b_noctalia(self):
        if not NOCTALIA or not os.path.isfile(NOCTALIA):
            return self._empty_page("No extended theme colors found. Add a theme file to config.conf to edit its palette here.")
        page = Gtk.ScrolledWindow()
        page.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.set_margin_top(10); box.set_margin_start(12); box.set_margin_end(12); box.set_margin_bottom(10)
        box.set_hexpand(True)
        page.set_child(box)
        lines = read_lines(NOCTALIA)

        order = [
            ("Surfaces", ["root_color", "split_color", "maximized_screen_color",
                          "global_color", "overlay_color", "scratchpad_color"]),
            ("Accents", ["border_color", "focus_color", "urgent_color", "drop_color"]),
            ("Jump labels", ["jump_label_decorate_fg_color", "jump_label_decorate_bg_color",
                             "jump_label_decorate_focus_fg_color", "jump_label_decorate_focus_bg_color",
                             "jump_label_decorate_border_color"]),
            ("Group bar", ["group_bar_decorate_fg_color", "group_bar_decorate_bg_color",
                           "group_bar_decorate_focus_fg_color", "group_bar_decorate_focus_bg_color",
                           "group_bar_decorate_border_color"]),
        ]
        labels = {
            "root_color": "Root", "split_color": "Split", "maximized_screen_color": "Maximized screen",
            "global_color": "Global", "overlay_color": "Overlay", "scratchpad_color": "Scratchpad",
            "border_color": "Border", "focus_color": "Focus", "urgent_color": "Urgent", "drop_color": "Drop",
            "jump_label_decorate_fg_color": "Decor fg", "jump_label_decorate_bg_color": "Decor bg",
            "jump_label_decorate_focus_fg_color": "Focus fg", "jump_label_decorate_focus_bg_color": "Focus bg",
            "jump_label_decorate_border_color": "Border",
            "group_bar_decorate_fg_color": "Decor fg", "group_bar_decorate_bg_color": "Decor bg",
            "group_bar_decorate_focus_fg_color": "Focus fg", "group_bar_decorate_focus_bg_color": "Focus bg",
            "group_bar_decorate_border_color": "Border",
        }

        found = []
        for raw in lines:
            st = raw.strip()
            if st.startswith("#") or "=" not in st:
                continue
            k = st.split("=", 1)[0].strip()
            if k.endswith("_color"):
                found.append(k)
        if not found:
            return self._empty_page("No extended theme colors found in " + shortpath(NOCTALIA) + ".")

        grouped = {g: [] for g, _ in order}
        other = []
        for k in found:
            for g, keys in order:
                if k in keys:
                    grouped[g].append(k)
                    break
            else:
                other.append(k)

        for g, _keys in order:
            if not grouped[g]:
                continue
            box.append(self._color_group_label(g))
            flow = self._color_flow()
            for k in grouped[g]:
                title = labels.get(k, k[:-6].replace("_", " ").capitalize())
                flow.append(self._color_card(title, k, NOCTALIA, lines))
            box.append(flow)
        if other:
            box.append(self._color_group_label("Other"))
            flow = self._color_flow()
            for k in other:
                flow.append(self._color_card(k[:-6].replace("_", " ").capitalize(), k, NOCTALIA, lines))
            box.append(flow)
        box.append(Gtk.Box(hexpand=True))
        return page

    def b_colors(self):
        if not COLORS or not os.path.isfile(COLORS):
            return self._empty_page("No base color file found. Add border, focus and urgent colors to a file sourced by config.conf.")
        lines = read_lines(COLORS)
        specs = [
            ("Border", "border_color", "Outline around every window."),
            ("Focus", "focus_color", "Border of the focused window."),
            ("Urgent", "urgent_color", "Windows demanding attention."),
        ]
        present = [(l, k, d) for l, k, d in specs if get_simple(lines, k) is not None]
        if not present:
            return self._empty_page("No border, focus or urgent colors found in " + shortpath(COLORS) + ".")
        page = Gtk.ScrolledWindow()
        page.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_margin_top(10); box.set_margin_start(12); box.set_margin_end(12); box.set_margin_bottom(10)
        box.set_hexpand(True)
        page.set_child(box)
        s = Section("Base colors")
        flow = self._color_flow(3)
        for label, key, desc in present:
            flow.append(self._color_card(label, key, COLORS, lines, desc))
        s.box.append(flow)
        box.append(s)
        base_name = os.path.basename(COLORS).lower()
        if "noctalia" in base_name:
            note_text = ("These colors come from Noctalia and can be regenerated by it. "
                         "Edit them here for the current theme, or override them in a later source file.")
        elif PROFILE is not None and PROFILE.dms and (os.sep + "dms" + os.sep) in COLORS:
            note_text = ("This file is generated by DMS. Remove its source line in config.conf "
                         "if you want these colors to become permanent.")
        else:
            note_text = "These colors are read from " + shortpath(COLORS) + "."
        note = Gtk.Label(label=note_text)
        note.add_css_class("dim-label")
        note.set_wrap(True)
        note.set_xalign(0)
        box.append(note)
        box.append(Gtk.Box(hexpand=True))
        return page

    def b_input_mouse(self):
