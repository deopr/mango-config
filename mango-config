        fields = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        for title, w, width in (("Mods", e_mods, 8), ("Key", e_key, 6), ("Action", e_act, 10), ("Args", e_args, 16)):
            w.set_width_chars(width)
