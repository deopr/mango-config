    def _show_wallpaper(self, row):
        if row is None:
            return
        path = getattr(row, "_path", None)
        if not path or not os.path.isfile(path):
            return
        self.wall_selected = path
        preview_error = ""
        try:
            texture = Gdk.Texture.new_from_filename(path)
            self.wall_pic.set_paintable(texture)
        except GLib.Error as ex:
            self.wall_pic.set_paintable(None)
            preview_error = str(ex)
        try:
            size = os.path.getsize(path)
        except OSError:
            size = 0
        if size >= 1024 * 1024:
            size_text = "%.1f MB" % (size / (1024.0 * 1024.0))
        elif size >= 1024:
            size_text = "%.0f KB" % (size / 1024.0)
        else:
            size_text = "%d bytes" % size
        self.wall_caption.set_text("%s  ·  %s" % (os.path.basename(path), size_text))
        self.wall_set_btn.set_sensitive(True)
        if preview_error:
            self.wall_status.set_text("Preview unavailable: %s" % preview_error)

    def _populate_wallpapers(self, select_path=None):
        if not hasattr(self, "wall_list"):
            return
        previous = select_path or self.wall_selected
        current = _current_wallpaper()
        files = _wallpaper_files(self.wall_dir)
        self._clear_container(self.wall_list)
        self.wall_rows = []
        target_row = None
        for path in files:
            row = Gtk.ListBoxRow()
            row._path = path
            row._name = os.path.basename(path)
            row.set_tooltip_text(path)
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            name = Gtk.Label(label=row._name)
            name.set_xalign(0)
            name.set_hexpand(True)
            name.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
            box.append(name)
            if current and os.path.realpath(path) == os.path.realpath(current):
                badge = Gtk.Label(label="current")
                badge.add_css_class("dim-label")
                box.append(badge)
            row.set_child(box)
            self.wall_list.append(row)
            self.wall_rows.append(row)
            if previous and os.path.realpath(path) == os.path.realpath(previous):
                target_row = row
        if target_row is None:
            for row in self.wall_rows:
                if current and os.path.realpath(row._path) == os.path.realpath(current):
                    target_row = row
                    break
        if target_row is None and self.wall_rows:
            target_row = self.wall_rows[0]
        self.wall_count.set_text("%d wallpaper%s" % (
            len(files), "" if len(files) == 1 else "s"))
        self._filter_wallpapers()
        if target_row is not None:
            self.wall_list.select_row(target_row)
            self._show_wallpaper(target_row)
        else:
            self.wall_selected = None
            self.wall_pic.set_paintable(None)
            self.wall_caption.set_text(
                "No images found in %s" % shortpath(self.wall_dir))
            self.wall_set_btn.set_sensitive(False)

    def _filter_wallpapers(self, _entry=None):
        if not hasattr(self, "wall_search") or not hasattr(self, "wall_rows"):
            return
        query = self.wall_search.get_text().strip().casefold()
        shown = 0
        for row in self.wall_rows:
            visible = not query or query in row._name.casefold()
            row.set_visible(visible)
            if visible:
                shown += 1
        total = len(self.wall_rows)
        if query:
            self.wall_count.set_text("%d of %d" % (shown, total))
        else:
            self.wall_count.set_text("%d wallpaper%s" % (
                total, "" if total == 1 else "s"))

    def _apply_wallpaper(self, path=None):
        path = path or self.wall_selected
        if not path or not os.path.isfile(path):
            self.wall_status.set_text("Select a wallpaper first.")
            return
        self.wall_set_btn.set_sensitive(False)
        self.wall_status.set_text("Applying wallpaper…")
        script = _light_wallpaper()
        if script:
            def worker():
                try:
                    proc = subprocess.run(
                        [script, path], capture_output=True, text=True, timeout=45)
                    code = proc.returncode
                    err = (proc.stderr or "").strip()
                except (OSError, subprocess.SubprocessError) as ex:
                    code, err = 1, str(ex)
                GLib.idle_add(self._wallpaper_done, path, code, err)

            threading.Thread(target=worker, daemon=True).start()
            return
        self._apply_wallpaper_fallback(path)

    def _apply_wallpaper_fallback(self, path):
        if os.path.islink(WALLPAPER_LINK):
            try:
                tmp = WALLPAPER_LINK + ".tmp"
                if os.path.lexists(tmp):
                    os.unlink(tmp)
                os.symlink(path, tmp)
                os.replace(tmp, WALLPAPER_LINK)
            except OSError:
                pass
        swaybg = shutil.which("swaybg")
        if not swaybg:
            self._wallpaper_done(path, 1, "swaybg is not installed")
            return
        service_active = False
        try:
            service_active = subprocess.run(
                ["systemctl", "--user", "is-active", "--quiet", "swaybg.service"],
                timeout=3).returncode == 0
        except (OSError, subprocess.SubprocessError):
            pass
        if service_active and os.path.islink(WALLPAPER_LINK):
            try:
                subprocess.run(
                    ["systemctl", "--user", "restart", "swaybg.service"],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                    timeout=8)
                self._wallpaper_done(path, 0, "")
            except (OSError, subprocess.SubprocessError) as ex:
                self._wallpaper_done(path, 1, str(ex))
            return
        try:
            subprocess.run(
                ["pkill", "-x", "swaybg"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
        except (OSError, subprocess.SubprocessError):
            pass
        try:
            subprocess.Popen(
                [swaybg, "-m", "fill", "-i", path],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True)
        except OSError as ex:
            self._wallpaper_done(path, 1, "could not start swaybg: %s" % ex)
            return
        self._wallpaper_done(path, 0, "")

    def _wallpaper_done(self, path, code, error):
        self.wall_set_btn.set_sensitive(True)
        if code == 0:
            _write_text(WALLPAPER_STATE, path)
            self.wall_status.set_text("Wallpaper applied · %s" % os.path.basename(path))
            self._populate_wallpapers(select_path=path)
        else:
            detail = error.splitlines()[-1] if error else "exit code %s" % code
            self.wall_status.set_text("Wallpaper failed: %s" % detail)
        return False

    def _quick_pick_wallpaper(self, _b=None):
        script = _light_wallpaper()
        fuzzel = shutil.which("fuzzel")
        if not script and not fuzzel:
            self.wall_status.set_text("fuzzel is not installed.")
            return
        self.wall_status.set_text("Fuzzel picker open…")
        self.wall_set_btn.set_sensitive(False)
        before = _current_wallpaper()

        def worker():
            choice = ""
            try:
                if script:
                    proc = subprocess.run([script], timeout=300)
                    GLib.idle_add(self._quick_pick_done, proc.returncode, "",
                                  before)
                    return
                names = [os.path.basename(p) for p in _wallpaper_files(self.wall_dir)]
                if not names:
                    GLib.idle_add(self._quick_pick_done, 1, "", before)
                    return
                proc = subprocess.run(
                    [fuzzel, "--dmenu", "--prompt=Wallpaper "],
                    input="\n".join(names), capture_output=True, text=True,
                    timeout=300)
                choice = (proc.stdout or "").strip()
            except (OSError, subprocess.SubprocessError):
                choice = ""
            GLib.idle_add(self._quick_pick_done, 0 if choice else 1, choice,
                          before)

        threading.Thread(target=worker, daemon=True).start()

    def _quick_pick_done(self, code, choice, before=None):
        if choice:
            self._apply_wallpaper(os.path.join(self.wall_dir, choice))
            return False
        self.wall_set_btn.set_sensitive(True)
        if code == 0:
            current = _current_wallpaper()
            self._populate_wallpapers(select_path=current)
            if current and current != before:
                self.wall_status.set_text("Wallpaper updated from fuzzel pick.")
            else:
                self.wall_status.set_text("No wallpaper change.")
        else:
            self.wall_status.set_text("Fuzzel picker closed.")
        return False

