def _mangobar_css(palette, font_size=13):
    """Render a mangobar stylesheet from a small, credited palette."""
    return """/* mangobar preset — generated by Mango Config.
 * Only properties supported by mangobar are used. Palette credit is in the
 * Mango Config Bar page; edit this file freely after applying.
 */
@define-color bg         %(bg)s;
@define-color fg         %(fg)s;
@define-color muted      %(muted)s;
@define-color dim        %(dim)s;
@define-color accent     %(accent)s;
@define-color accent2    %(accent2)s;
@define-color surface    %(surface)s;
@define-color surface_hi %(surface_hi)s;
@define-color on_accent  %(on_accent)s;

* {
    font-family: "JetBrainsMono Nerd Font";
    font-size: %(font_size)dpx;
    font-weight: bold;
    color: @fg;
    background: none;
    padding: 0px 12px;
    margin: 4px 2px;
    border-radius: 11px;
}

#bar { background: none; margin: 8px 10px; }
#bar.sel { background: none; }

#tags, #workspaces { background: none; padding: 0px; }
#tags.active, #workspaces button.active {
    background-color: @accent;
    color: @on_accent;
}
#tags.occupied, #workspaces button.occupied {
    background-color: @surface_hi;
    color: @fg;
}
#tags.urgent, #workspaces button.urgent {
    background-color: @accent2;
    color: @on_accent;
}
#tags.empty, #tags.inactive, #workspaces button {
    background: none;
    color: @dim;
}
#tags:hover, #workspaces button:hover {
    background-color: @surface_hi;
    color: @fg;
}

#layout {
    background-color: @surface_hi;
    color: @accent;
    padding: 0px 9px;
}
#title { background-color: @surface; color: @fg; }

#cpu, #mem, #hideclients { background-color: @surface; color: @fg; }
#mem { color: @accent; }
#volume, #brightness, #custom-brightness {
    background-color: @surface;
    color: @fg;
}
#brightness, #custom-brightness { color: @accent; }
#custom-brightness:hover { background-color: @surface_hi; }

#network { background-color: @surface_hi; color: @fg; }
#network.connected { background-color: @surface_hi; color: @fg; }
#network.ethernet { color: @accent; }
#network.wifi { color: @accent2; }
#network.disconnected { background: none; color: @muted; }

#battery { background-color: @surface; color: @fg; }
#keyboardlayout, #keymode { background-color: @surface; color: @accent; }

#clock { background-color: @surface; color: @fg; }
#clock.date { background-color: @surface; color: @muted; padding: 0px 8px; }
#clock.time { background-color: @surface; color: @fg; }

#tray { background: none; padding: 0px 6px; margin: 2px 2px; }
#custom-power {
    background-color: @surface_hi;
    color: @accent;
    font-size: 17px;
    padding: 0px 12px;
}
#custom-power:hover { background-color: @accent; color: @on_accent; }
#separator { background: none; color: @dim; padding: 0px 4px; }
#overview { background-color: @accent; color: @on_accent; }
""" % dict(palette, font_size=font_size)


def _waybar_css(palette):
    """Render a Waybar stylesheet from the same credited palettes."""
    return """/* Waybar preset — generated by Mango Config.
 * Palette credit is in the Mango Config Bar page. Modules are Mango-safe:
 * ext/workspaces + a mmsg-backed custom/layout module.
 */
@define-color base       %(base)s;
@define-color surface    %(surface)s;
@define-color overlay    %(overlay)s;
@define-color muted      %(muted)s;
@define-color subtle     %(subtle)s;
@define-color text       %(text)s;
@define-color accent     %(accent)s;
@define-color accent2    %(accent2)s;
@define-color green      %(green)s;
@define-color peach      %(peach)s;
@define-color red        %(red)s;
@define-color on_accent  %(on_accent)s;

* {
    font-family: "JetBrainsMono Nerd Font";
    font-size: 12px;
    font-weight: 600;
    transition: color 140ms ease-out, background-color 140ms ease-out;
}
window#waybar { background-color: transparent; }

#workspaces,
#clock,
#mpris,
#tray,
#memory,
#cpu,
#pulseaudio,
#network,
#custom-launcher,
#custom-layout,
#custom-brightness,
#custom-power {
    background-color: alpha(@base, 0.92);
    border: 1px solid alpha(@overlay, 0.65);
    border-radius: 13px;
    padding: 2px 11px;
    margin: 3px 4px 4px 4px;
}
#workspaces:hover,
#clock:hover,
#mpris:hover,
#tray:hover,
#memory:hover,
#cpu:hover,
#pulseaudio:hover,
#network:hover,
#custom-launcher:hover,
#custom-layout:hover,
#custom-brightness:hover,
#custom-power:hover {
    border: 1px solid alpha(@accent, 0.65);
}

#workspaces {
    font-size: 14px;
    padding: 2px 8px;
}
#workspaces button {
    color: @subtle;
    padding: 0 5px;
    margin: 0;
    border-radius: 9px;
}
#workspaces button.active { color: @accent; }
#workspaces button.empty { color: @muted; }
#workspaces button.empty.active { color: @muted; }
#workspaces button.urgent { color: @red; }
#workspaces button:hover { color: @text; }

#custom-launcher { color: @peach; font-size: 14px; }
#custom-layout { color: @accent2; }
#custom-power { color: @red; font-size: 14px; }
#custom-power:hover {
    color: @red;
    border: 1px solid alpha(@red, 0.6);
}
#custom-brightness { color: @peach; font-size: 14px; }
#clock { color: @accent; }
#mpris { color: @green; }
#memory { color: @accent2; }
#cpu { color: @subtle; }
#pulseaudio { color: @peach; }
#network { color: @green; }
#tray { color: @text; }

#pulseaudio.muted,
#network.disconnected {
    color: @muted;
}

tooltip {
    background-color: alpha(@base, 0.97);
    border: 1px solid alpha(@accent, 0.45);
    border-radius: 10px;
    padding: 6px 10px;
}
tooltip label { color: @text; }
""" % palette


