def read_lines(path):
    if not path:
        return []
    try:
        with open(path, encoding="utf-8") as f:
            return f.readlines()
    except FileNotFoundError:
        return []


def write_lines(path, lines):
    if not path:
        return
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.writelines(lines)


KEY_RE = re.compile(r"^([A-Za-z0-9_]+)\s*=\s*(.*)$")


def set_simple(lines, key, new_value, sep="="):
    out, replaced = [], False
    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            out.append(line)
            continue
        m = KEY_RE.match(stripped)
        if m and m.group(1) == key:
            lead = line[: len(line) - len(line.lstrip())]
            trail = ""
            out.append(f"{lead}{key}{sep}{new_value}{trail}\n")
            replaced = True
        else:
            out.append(line)
    if not replaced:
        out.append(f"{key}{sep}{new_value}\n")
    return out


def key_sep(lines, key, default="="):
    pat = re.compile(r"^\s*" + re.escape(key) + r"(\s*=\s*)")
    for line in lines:
        m = pat.match(line)
        if m:
            return m.group(1)
    return default


def fmt_float(v):
    text = ("%.2f" % float(v)).rstrip("0").rstrip(".")
    return text if text not in ("", "-") else "0"


def get_simple(lines, key, default=None):
    for line in lines:
        m = KEY_RE.match(line.strip())
        if m and m.group(1) == key:
            return m.group(2).strip()
    return default


def parse_kv(value):
    d = {}
    for part in value.split(","):
        part = part.strip()
        if ":" in part:
            k, v = part.split(":", 1)
            d[k.strip()] = v.strip()
    return d


def build_kv(d, order):
    return ",".join(f"{k}:{d.get(k, '')}" for k in order if k in d)


def set_kv_line(lines, prefix, new_dict, order):
    out, replaced = [], False
    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            out.append(line)
            continue
        if stripped.startswith(prefix + "="):
            old = stripped[len(prefix) + 1:]
            merged = parse_kv(old)
            merged.update(new_dict)
            lead = line[: len(line) - len(line.lstrip())]
            trail = ""
            out.append(f"{lead}{prefix}={build_kv(merged, order)}{trail}\n")
            replaced = True
        else:
            out.append(line)
    if not replaced:
        out.append(f"{prefix}={build_kv(new_dict, order)}\n")
    return out


def hex_to_rgba(h):
    h = (h or "").strip()
    if h.lower().startswith("0x"):
        h = h[2:]
    elif h.startswith("#"):
        h = h[1:]
    if len(h) == 6:
        h = h + "ff"
    h = "#" + h
    rgba = Gdk.RGBA()
    rgba.parse(h)
    return rgba


def rgba_to_hex(rgba):
    return "0x%02x%02x%02x%02x" % (int(rgba.red * 255), int(rgba.green * 255),
                                  int(rgba.blue * 255), int(rgba.alpha * 255))


def rgba_display(rgba):
    r = int(round(rgba.red * 255))
    g = int(round(rgba.green * 255))
    b = int(round(rgba.blue * 255))
    a = int(round(rgba.alpha * 255))
    if a >= 255:
        return "#%02X%02X%02X" % (r, g, b)
    return "#%02X%02X%02X%02X" % (r, g, b, a)


def discover_cursor_themes():
    themes = []
    seen = set()
    dirs = [
        os.path.expanduser("~/.icons"),
        os.path.expanduser("~/.local/share/icons"),
        "/usr/share/icons",
        "/usr/local/share/icons",
    ]
    for d in dirs:
        if not os.path.isdir(d):
            continue
        try:
            names = sorted(os.listdir(d))
        except Exception:
            continue
        for name in names:
            if name in seen:
                continue
            p = os.path.join(d, name)
            if not os.path.isdir(p):
                continue
            if os.path.isdir(os.path.join(p, "cursors")) or os.path.isfile(os.path.join(p, "cursor.theme")):
                seen.add(name)
                themes.append(name)
    return themes


class Row(Gtk.Box):
    def __init__(self, label, widget):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.set_margin_top(6)
        self.set_margin_bottom(6)
        self.set_hexpand(True)
        self.set_valign(Gtk.Align.CENTER)
        lbl = Gtk.Label(label=label)
        lbl.set_halign(Gtk.Align.START)
        lbl.set_hexpand(True)
        lbl.set_xalign(0)
        self.append(lbl)
        widget.set_hexpand(False)
        widget.set_halign(Gtk.Align.END)
        self.append(widget)


class Section(Gtk.Box):
    def __init__(self, title):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.set_margin_top(10)
        self.set_margin_start(12)
        self.set_margin_end(12)
        self.set_margin_bottom(6)
        lbl = Gtk.Label(label=title)
        lbl.add_css_class("title")
        lbl.set_halign(Gtk.Align.START)
        self.append(lbl)
        self.append(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL))
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.box.set_hexpand(True)
        self.append(self.box)

    def add_row(self, label, widget):
        self.box.append(Row(label, widget))


class App(Gtk.Application):
    def __init__(self, profile=None, tab=None, no_reload=False):
        super().__init__(application_id=APP_ID)
        self.profile = profile
        self.tab = tab
        self.no_reload = no_reload
        self.controls = []
        self._outputs_fields = {}
        self._outputs_order = []
        self.wr_rows = []
        self.wr_box = None
        self.kb_rows = []
        self.kb_box = None
        self._dropdown_themes = {}
        self.win = None
        self._guard_src = None
        self._guard_old = None
        self._guard_left = 0

    def _spin(self, value, lo, hi, step):
        adj = Gtk.Adjustment.new(value, lo, hi, step, step * 10, 0)
        sb = Gtk.SpinButton.new(adj, step, 0)
        sb.set_digits(0 if float(step).is_integer() else 2)
        return sb

    def _switch(self, state):
        sw = Gtk.Switch.new()
        sw.set_state(bool(state))
        return sw

    def _entry(self, text):
        e = Gtk.Entry.new()
        e.set_text(text or "")
        return e

    def _color(self, hexstr):
        btn = Gtk.ColorDialogButton.new()
        btn.set_dialog(Gtk.ColorDialog.new())
        try:
            btn.set_rgba(hex_to_rgba(hexstr))
        except Exception:
            pass
        return btn

    def field(self, widget, kind, path, key, order=None, index=None):
        self.controls.append({"widget": widget, "kind": kind, "path": path, "key": key,
                              "order": order, "index": index})

    def do_activate(self):
        win = Gtk.ApplicationWindow(application=self)
        self.win = win
        win.set_title("Mango Config")
        scr = None
        try:
            from gi.repository import Gdk as _Gdk
            _d = _Gdk.Display.get_default()
            if _d is not None:
                scr = _d.get_default_screen()
        except Exception:
            scr = None
        geo = scr.get_monitor_geometry(0) if scr is not None else None
        if geo is not None:
            w = max(640, int(geo.width * 0.92))
            h = max(480, int(geo.height * 0.78))
            win.set_default_size(min(w, 1440), min(h, 1000))
        else:
            win.set_default_size(920, 840)
        stack = Gtk.Stack()
        stack.set_hexpand(True)
        stack.set_vexpand(True)
        stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        stack.set_transition_duration(120)

        side = Gtk.ListBox()
        side.add_css_class("nav-sidebar")
        side.set_selection_mode(Gtk.SelectionMode.SINGLE)

        sections = [
            ("Appearance", [
                ("Layout & gaps", "layout", self.b_layout, "preferences-desktop-theme", LAYOUT,
                 "Gaps, borders and corner rounding for the tiling layout."),
                ("Theme colors", "theme", self.b_noctalia, "applications-graphics", NOCTALIA,
                 "Extended colors from your theme — click a swatch to pick a new one."),
                ("Base colors", "colors", self.b_colors, "preferences-desktop-font", COLORS,
                 "Border, focus and urgent colors from the file that takes effect."),
                ("Cursor", "cursor", self.b_cursor, "input-mouse", CURSOR,
                 "Cursor theme and size for Wayland clients."),
            ]),
            ("Input", [
                ("Mouse", "mouse", self.b_input_mouse, "input-mouse", INPUT,
                 "Pointer speed, acceleration and natural scrolling."),
                ("Touchpad", "touchpad", self.b_input_touchpad, "input-touchpad", INPUT,
                 "Tap to click, scroll direction and gesture behavior."),
                ("Keybinds", "keys", self.b_keybinds, "preferences-desktop-keyboard", BINDS,
                 "All binds found in your config. Search, then edit only what you need."),
            ]),
            ("Display", [
                ("Outputs", "outputs", self.b_outputs, "video-display", OUTPUTS,
                 "Monitor rules: resolution, refresh, scale, position, transform and VRR."),
            ]),
            ("Behavior", [
                ("Window rules", "rules", self.b_windowrules, "preferences-system-windows", WINDOWRULES,
                 "Per-app rules — floating and other matching behavior."),
            ]),
        ]

        pid_rows = {}
        for cat, items in sections:
            hdr = Gtk.Label(label=cat.upper())
            hdr.add_css_class("nav-cat")
            hdr.set_xalign(0)
            row_h = Gtk.ListBoxRow()
            row_h.set_selectable(False)
            row_h.set_activatable(False)
            row_h.set_child(hdr)
            side.append(row_h)
            for title, pid, build, icon, path, desc in items:
                stack.add_named(self._wrap_page(title, desc, path, build()), pid)
                hb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                hb.append(Gtk.Image.new_from_icon_name(icon))
                lbl = Gtk.Label(label=title)
                lbl.set_xalign(0)
                hb.append(lbl)
                r = Gtk.ListBoxRow()
                r.set_child(hb)
                r._pid = pid
                side.append(r)
                pid_rows[pid] = r

        def on_nav(_lb, r):
            if r is not None and getattr(r, "_pid", None):
                stack.set_visible_child_name(r._pid)

        side.connect("row-selected", on_nav)

        want = (self.tab or os.environ.get("MANGO_CONFIG_TAB", "")).strip().lower()
        chosen = pid_rows.get(want) if want else None
        if chosen is None:
            chosen = next(iter(pid_rows.values()))
        side.select_row(chosen)
        stack.set_visible_child_name(chosen._pid)

        nav_scroll = Gtk.ScrolledWindow()
        nav_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        nav_scroll.set_child(side)
        nav_scroll.set_vexpand(True)

        side_col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        side_col.set_size_request(196, -1)
        side_col.append(nav_scroll)
        open_btn = Gtk.Button(label="Open config folder")
        open_btn.add_css_class("flat")
        open_btn.set_tooltip_text(CONFIG_DIR)
        open_btn.set_margin_top(4)
        open_btn.set_margin_start(8)
        open_btn.set_margin_end(8)
        open_btn.set_margin_bottom(8)
        open_btn.connect("clicked", lambda _b: subprocess.Popen(["xdg-open", CONFIG_DIR]))
        side_col.append(open_btn)

        body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        body.set_vexpand(True)
        body.append(side_col)
        body.append(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL))
        body.append(stack)

        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        bar.set_margin_top(10)
        bar.set_margin_start(12)
        bar.set_margin_end(12)
        bar.set_margin_bottom(10)
        self.status = Gtk.Label(label="")
        self.status.set_hexpand(True)
        self.status.set_xalign(1)
        ab = Gtk.Button(label="Apply & reload Mango")
        ab.add_css_class("suggested-action")
        ab.connect("clicked", self.on_apply)
        rb = Gtk.Button(label="Discard / reload from disk")
        rb.connect("clicked", self.b_reset)
        bar.append(rb)
        bar.append(ab)
        bar.append(self.status)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        problem = (PROFILE.error if PROFILE is not None and PROFILE.error else
                   (f"Config directory not found: {CONFIG_DIR}"
                    if not os.path.isdir(CONFIG_DIR) else ""))
        if problem:
            warn = Gtk.Label(label=problem)
            warn.add_css_class("warn-banner")
            warn.set_xalign(0)
            warn.set_wrap(True)
            root.append(warn)
            ab.set_sensitive(False)
            rb.set_sensitive(False)
        self.apply_btn = ab
        self.guard_revealer = Gtk.Revealer()
        self.guard_revealer.set_transition_type(Gtk.RevealerTransitionType.SLIDE_DOWN)
        gbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        gbox.add_css_class("guard-banner")
        gicon = Gtk.Image.new_from_icon_name("dialog-warning-symbolic")
        gicon.set_valign(Gtk.Align.CENTER)
        gtext = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        gtext.set_hexpand(True)
        gtitle = Gtk.Label(label="Keep this display setup?")
        gtitle.set_xalign(0)
        gtitle.add_css_class("bind-combo")
        self.guard_label = Gtk.Label(label="Reverting to the previous settings in 10s…")
        self.guard_label.set_xalign(0)
        self.guard_label.add_css_class("dim-label")
        gtext.append(gtitle)
        gtext.append(self.guard_label)
        self.guard_revert = Gtk.Button(label="Revert now")
        self.guard_keep = Gtk.Button(label="Keep settings")
        self.guard_keep.add_css_class("suggested-action")
        self.guard_revert.connect("clicked", lambda _b: self._guard_finish(True))
        self.guard_keep.connect("clicked", lambda _b: self._guard_finish(False))
        gbox.append(gicon)
        gbox.append(gtext)
        gbox.append(self.guard_revert)
        gbox.append(self.guard_keep)
        self.guard_revealer.set_child(gbox)
        root.append(self.guard_revealer)
        root.append(body)
        root.append(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL))
        root.append(bar)
        win.set_child(root)
        win.connect("close-request", self._on_close_request)
        self._install_css()
