    def load_output_rules(self):
        if getattr(self, "out_box", None) is None:
            return
        self.out_rows = []
        self._clear_container(self.out_box)
        for raw in read_lines(OUTPUTS):
            if raw.strip().startswith("monitor_rule="):
                self.add_output_rule(line=raw.strip())
        if not self.out_rows:
            self.add_output_rule()

    def add_output_rule(self, _b=None, line="", prefill=None):
        raw = (line or "").strip()
        kv = {}
        if raw.startswith("monitor_rule="):
            kv = parse_kv(raw[len("monitor_rule="):])
        if prefill:
            kv.update(prefill)
        known = {"name", "width", "height", "refresh", "x", "y", "scale", "rr", "vrr", "hdr", "primary", "disable", "custom"}
        extra = {k: v for k, v in kv.items() if k not in known}

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        card.add_css_class("bind-row")

        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
