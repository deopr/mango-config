    def update_kb_count(self):
        if getattr(self, "kb_count", None) is None:
            return
        n = len(getattr(self, "kb_rows", []))
        groups = len(getattr(self, "kb_cards", []))
        if groups == n:
            self.kb_count.set_label(f"{n} binds")
        else:
            action_word = "action" if groups == 1 else "actions"
            shortcut_word = "shortcut" if n == 1 else "shortcuts"
            self.kb_count.set_label(f"{groups} {action_word} · {n} {shortcut_word}")

    def filter_kb(self):
        if getattr(self, "kb_search", None) is None:
            return
        q = (self.kb_search.get_text() or "").strip().lower()
        shown = 0
        per_cat = {}
        self._kb_filtering = True
        for exp, inner, ci in getattr(self, "kb_groups", []):
            child = inner.get_first_child()
            matches = 0
            while child is not None:
                nxt = child.get_next_sibling()
                hit = (not q) or (q in getattr(child, "_search_text", ""))
                child.set_visible(hit)
                matches += 1 if hit else 0
                child = nxt
            exp.set_visible(matches > 0)
            if q:
                exp.set_expanded(matches > 0)
            else:
                exp.set_expanded(False)
            per_cat[ci] = per_cat.get(ci, 0) + matches
            shown += matches
        self._kb_filtering = False
        for hdr, cat_box, ci in getattr(self, "kb_cats", []):
            hdr.set_visible(per_cat.get(ci, 0) > 0)
        if q:
            self.kb_count.set_label(f"{shown} match" + ("" if shown == 1 else "es"))
        else:
            self.update_kb_count()

    def _on_kb_expanded(self, exp, _pspec):
        if getattr(self, "_kb_filtering", False) or getattr(self, "_kb_collapsing", False):
            return
        if not exp.get_expanded():
            return
        self._kb_collapsing = True
        for other in getattr(self, "kb_expanders", []):
            if other is not exp and other.get_expanded():
                other.set_expanded(False)
        self._kb_collapsing = False

    def _kb_parts(self, raw):
        raw = (raw or "").strip()
        m = self.BIND_RE.match(raw)
        flag = m.group(1) if m else "bind"
        rest = m.group(2) if m else raw
        parts = rest.split(",", 3)
        mods = parts[0] if len(parts) > 0 else ""
        key = parts[1] if len(parts) > 1 else ""
        action = parts[2] if len(parts) > 2 else ""
        args = parts[3] if len(parts) > 3 else ""
        while self.BIND_RE.match(mods.strip()):
            mods = self.BIND_RE.match(mods.strip()).group(2)
        return flag, mods.strip(), key.strip(), action.strip(), args.strip()

    def _kb_identity(self, raw):
        flag, _mods, _key, action, args = self._kb_parts(raw)
        return flag, action, args

    def _kb_combo(self, mods, key):
        mods = (mods or "").strip()
        key = (key or "").strip()
        if mods and key:
            return mods + "+" + key
        return key or mods

    def _kb_combo_parts(self, text):
        text = (text or "").strip()
        while self.BIND_RE.match(text):
            text = self.BIND_RE.match(text).group(2).strip()
        if "+" in text:
            mods, key = text.rsplit("+", 1)
            return mods.strip(), key.strip()
        return "", text.strip()

