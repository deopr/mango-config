    def _brightness_start_probe(self):
        if not hasattr(self, "bright_status"):
            return
        self.bright_refresh.set_sensitive(False)
        self.bright_scale.set_sensitive(False)
        self.bright_status.set_text("Detecting brightness backend…")
        self.bright_value.set_text("—")

        def worker():
            backend, value, error = _brightness_probe()
            GLib.idle_add(self._brightness_probed, backend, value, error)

        threading.Thread(target=worker, daemon=True).start()

    def _brightness_probed(self, backend, value, error):
        if not hasattr(self, "bright_status"):
            return False
        self.bright_refresh.set_sensitive(True)
        self.bright_backend = backend
        if backend is None or value is None:
            self.bright_scale.set_sensitive(False)
            self.bright_value.set_text("—")
            self.bright_status.set_text(
                "No controllable brightness found. Install brightnessctl or light, "
                "or make the backlight writable.%s" %
                (" (%s)" % error if error else ""))
            return False
        self.bright_loading = True
        self.bright_scale.set_value(value)
        self.bright_loading = False
        self.bright_value.set_text("%d%%" % value)
        self.bright_scale.set_sensitive(True)
        self.bright_status.set_text("Using %s · %d%%" % (backend["label"], value))
        return False

    def _brightness_changed(self, scale):
        value = int(round(scale.get_value()))
        if hasattr(self, "bright_value"):
            self.bright_value.set_text("%d%%" % value)
        if self.bright_loading or self.bright_backend is None:
            return
        if self.bright_timer is not None:
            GLib.source_remove(self.bright_timer)
        self.bright_timer = GLib.timeout_add(300, self._brightness_commit)

    def _brightness_commit(self):
        self.bright_timer = None
        if self.bright_backend is None:
            return False
        self.bright_pending = int(round(self.bright_scale.get_value()))
        self._brightness_start_pending()
        return False

    def _brightness_start_pending(self):
        if self.bright_busy or self.bright_pending is None:
            return
        backend = self.bright_backend
        value = self.bright_pending
        self.bright_pending = None
        self.bright_busy = True
        self.bright_status.set_text("Setting %d%%…" % value)

        def worker():
            ok, message = _brightness_set(backend, value)
            GLib.idle_add(self._brightness_set_done, ok, message, value)

        threading.Thread(target=worker, daemon=True).start()

    def _brightness_set_done(self, ok, message, value):
        self.bright_busy = False
        if ok:
            label = (self.bright_backend or {}).get("label", "brightness backend")
            self.bright_status.set_text("Using %s · %d%%" % (label, value))
        else:
            self.bright_status.set_text("Brightness failed: %s" % message)
        if self.bright_pending is not None:
            self._brightness_start_pending()
        return False

