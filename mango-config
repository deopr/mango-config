WALLPAPER_EXTS = (".png", ".jpg", ".jpeg", ".webp", ".bmp", ".gif")


def _wallpaper_files(directory):
    try:
        names = [
            entry.path for entry in os.scandir(directory)
            if entry.is_file() and entry.name.lower().endswith(WALLPAPER_EXTS)
        ]
    except OSError:
        return []
    return sorted(names, key=lambda p: os.path.basename(p).casefold())


def _current_wallpaper():
    for path in (WALLPAPER_LINK, WALLPAPER_STATE):
        try:
            if os.path.islink(path):
                target = os.path.realpath(path)
            elif os.path.isfile(path):
                target = _read_text(path)
            else:
                continue
            if target and os.path.isfile(target):
                return target
        except OSError:
            continue
    return None


def _light_wallpaper():
    for candidate in (
            os.path.expanduser("~/.local/bin/light-wallpaper"),
            shutil.which("light-wallpaper")):
        if candidate and os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None


def _light_night():
    for candidate in (
            os.path.expanduser("~/.local/bin/light-night"),
            shutil.which("light-night")):
        if candidate and os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None


def _night_marker():
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
    return os.path.join(runtime, "mango-night-mode")


def _sync_night_marker(enabled):
    # A common optional keybind helper (light-night) uses this runtime marker
    # to decide whether its next invocation turns the effect on or off. Keep
    # that marker in sync when that helper is installed; other setups ignore it.
    if not _light_night():
        return
    marker = _night_marker()
    try:
        if enabled:
            open(marker, "a").close()
        elif os.path.exists(marker):
            os.unlink(marker)
    except OSError:
        pass


def _nightlight_process():
    try:
        out = subprocess.run(
            ["pgrep", "-x", "gammastep"], capture_output=True, text=True,
            timeout=2)
    except (OSError, subprocess.SubprocessError):
        return False, None
    for pid in (out.stdout or "").split():
        try:
            raw = open("/proc/%s/cmdline" % pid, "rb").read()
        except OSError:
            continue
        args = [a.decode("utf-8", "ignore") for a in raw.split(b"\0") if a]
        temp = None
        for i, arg in enumerate(args):
            if arg in ("-O", "--temperature") and i + 1 < len(args):
                try:
                    temp = int(args[i + 1])
                except ValueError:
                    pass
            elif arg.startswith("--temperature="):
                try:
                    temp = int(arg.split("=", 1)[1])
                except ValueError:
                    pass
        return True, temp
    return False, None


def _set_nightlight(enabled, temperature):
    gammastep = shutil.which("gammastep")
    if not gammastep:
        return False, "gammastep is not installed"
    try:
        subprocess.run(
            ["systemctl", "--user", "stop", "gammastep.service"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=4)
    except (OSError, subprocess.SubprocessError):
        pass
    try:
        subprocess.run(
            ["pkill", "-x", "gammastep"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
    except (OSError, subprocess.SubprocessError):
        pass
    if enabled:
        try:
            subprocess.Popen(
                [gammastep, "-m", "wayland", "-O", str(int(temperature))],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True)
        except OSError as ex:
            return False, "could not start gammastep: %s" % ex
        time.sleep(0.35)
        running, actual = _nightlight_process()
        if not running:
            return False, "gammastep did not stay running"
        _write_json(NIGHT_STATE, {"enabled": True,
                                  "temperature": actual or int(temperature)})
        _sync_night_marker(True)
        return True, "Night light on · %sK" % (actual or int(temperature))
    _write_json(NIGHT_STATE, {"enabled": False, "temperature": int(temperature)})
    _sync_night_marker(False)
    return True, "Night light off"


def _expand_source(value, config_dir):
    v = value.strip().strip('"').strip("'")
    home = os.path.expanduser("~")
    v = v.replace("${HOME}", home).replace("$HOME", home)
    if v.startswith("~"):
        v = os.path.expanduser(v)
    elif v.startswith("./"):
        v = os.path.join(config_dir, v[2:])
    elif not os.path.isabs(v):
        guess = os.path.join(config_dir, v)
        v = guess if os.path.exists(guess) else v
    return os.path.normpath(v)


def _file_keys(path):
    keys = []
    for line in read_lines(path):
        st = line.strip()
        if not st or st.startswith("#") or st.startswith("["):
            continue
        m = KEY_RE.match(st)
        if m:
            keys.append(m.group(1))
    return keys


class Profile:
    def __init__(self, config_dir):
        self.dir = config_dir
        self.main = os.path.join(config_dir, "config.conf")
        self.toml = os.path.join(config_dir, "config.toml")
        self.files = []
        self.paths = {role: None for role in
                      ("layout", "input", "cursor", "outputs", "rules", "binds",
                       "colors", "theme")}
        self.dms = False
        self.error = ""
        self.warnings = []

    def path(self, role):
        return self.paths.get(role)


def _collect_included_files(profile):
    seen = set()
    ordered = []

    def visit(path):
        real = os.path.realpath(path)
        if real in seen or not os.path.isfile(path):
            return
        seen.add(real)
        ordered.append(path)
        if path.lower().endswith(".toml"):
            return
        for line in read_lines(path):
            st = line.strip()
            if not st or st.startswith("#"):
                continue
            m = re.match(r"^(source_optional|source)\s*=\s*(.+)$", st)
            if not m:
                continue
            raw = m.group(2).strip()
            if "$" in raw and "$HOME" not in raw and "${HOME}" not in raw:
                profile.warnings.append("Skipped source with unresolved variable: " + raw)
                continue
            visit(_expand_source(raw, profile.dir))

    if os.path.isfile(profile.main):
        visit(profile.main)
    profile.files = ordered


def discover_profile(config_dir):
    profile = Profile(config_dir)
    if not os.path.isfile(profile.main):
        if os.path.isfile(profile.toml):
            profile.error = ("Mango is using config.toml, which this version does not "
                             "edit yet. Use config.conf or convert the TOML file.")
        else:
            profile.error = "No config.conf found in " + shortpath(config_dir)
        return profile

    _collect_included_files(profile)
    key_map = {p: _file_keys(p) for p in profile.files}

    for role in ("layout", "input", "cursor", "outputs", "rules", "binds"):
        scored = []
        for idx, path in enumerate(profile.files):
            keys = key_map.get(path, [])
            if role == "binds":
                n = sum(1 for k in keys if k.lower().startswith("bind"))
            else:
                n = sum(1 for k in keys if k in ROLE_KEYS[role])
            if n:
                scored.append((n, idx, path))
        if scored:
            scored.sort(key=lambda t: (t[0], t[1]))
            profile.paths[role] = scored[-1][2]
        else:
            for name in FLAT_NAMES[role]:
                cand = os.path.join(profile.dir, name)
                if cand in profile.files:
                    profile.paths[role] = cand
                    break
            if profile.paths[role] is None:
                for path in profile.files:
                    if os.path.basename(path) in FLAT_NAMES[role]:
                        profile.paths[role] = path

    base_keys = {"border_color", "focus_color", "urgent_color"}
    base_scored = []
    for idx, path in enumerate(profile.files):
        n = sum(1 for k in key_map.get(path, []) if k in base_keys)
        if n:
            base_scored.append((n, idx, path))
    if base_scored:
        base_scored.sort(key=lambda t: (t[0], t[1]))
        profile.paths["colors"] = base_scored[-1][2]
    else:
        for name in FLAT_NAMES["colors"]:
            cand = os.path.join(profile.dir, name)
            if cand in profile.files:
                profile.paths["colors"] = cand
                break

    theme_scored = []
    for idx, path in enumerate(profile.files):
        keys = key_map.get(path, [])
        n = sum(1 for k in keys if k.endswith("_color") and k not in base_keys)
        if n:
            priority = 1 if re.search(r"theme|noctalia|color", os.path.basename(path), re.I) else 0
            theme_scored.append((n, priority, idx, path))
    if theme_scored:
        theme_scored.sort(key=lambda t: (t[0], t[1], t[2]))
        profile.paths["theme"] = theme_scored[-1][3]
    else:
        for name in FLAT_NAMES["theme"]:
            cand = os.path.join(profile.dir, name)
            if cand in profile.files:
                profile.paths["theme"] = cand
                break

    dms_prefix = os.path.join(profile.dir, "dms") + os.sep
    profile.dms = any(p and p.startswith(dms_prefix) for p in profile.paths.values())
    return profile


